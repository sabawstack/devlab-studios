{
  "name": "devlab-studios",
  "private": true,
  "version": "2.4.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "eslint .",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit": "audit-ci --config audit-ci.json",
    "prepare": "husky",
    "cms:seed:insights": "node scripts/cms/generate-insights-seed.mjs",
    "cms:seed:projects": "node scripts/cms/generate-project-seed.mjs > scripts/cms/seed/project-seed.sql",
    "cms:seed:mailbox-preview": "node scripts/cms/generate-mailbox-preview-seed.mjs > scripts/cms/seed/mailbox-preview-seed.sql",
    "cms:upload:project-media": "node scripts/cms/upload-project-media.mjs",
    "cms:hash-admin-password": "node scripts/cms/hash-admin-password.mjs",
    "cms:mirror-preview": "node scripts/cms/mirror-production-to-preview.mjs",
    "lead-engine:seed": "node scripts/lead-engine/seed.mjs > scripts/lead-engine/seed.sql"
  },
  "lint-staged": {
    "*.{js,jsx,ts}": "eslint --fix",
    "*.css": "stylelint --fix"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.0.1",
    "astro": "^7.4.11",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^0.562.0",
    "postal-mime": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/tailwind": "^6.0.2",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.49",
    "simple-icons": "^16.37.0",
    "stylelint": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}
