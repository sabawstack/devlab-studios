# ============================================================================
# SECURITY WARNING: DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ============================================================================
# This file contains PLACEHOLDER values only.
# Copy this to .env.local and fill with your actual credentials.
# .env.local is git-ignored and will not be committed.
# 
# Configure your Resend API key below.
# If you expose any secret endpoint/token, rotate it immediately.
# ============================================================================

# Frontend endpoint for contact submissions
# Use default '/api/contact' for local/prod proxy flow
VITE_CONTACT_API_URL=/api/contact

# Contact-form lead delivery via Resend (do NOT use VITE_ for secrets)
# RESEND_FROM_EMAIL/LEAD_NOTIFICATION_EMAIL have working defaults in
# wrangler.jsonc's `vars` — only the API key is a secret.
RESEND_API_KEY=re_your-resend-api-key-here
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# "true" appends static-fallback projects D1 lacks (legacy); anything else
# makes D1 the only source. Set per environment in wrangler.jsonc `vars`.
PROJECTS_STATIC_MERGE=

# Public base URL of the media bucket (set in wrangler.jsonc `vars`). Image
# URLs stored in D1 are built from it; see AGENTS.md before regenerating seeds.
R2_PUBLIC_BASE_URL=

# ============================================================================
# Admin (/admin)
# ============================================================================
# `password` in every deployed environment (set in wrangler.jsonc `vars`).
# `disabled` is honoured only for a localhost request AND with
# ADMIN_AUTH_DISABLED_LOCAL_ONLY=true in .dev.vars — never in a deployed Worker.
ADMIN_AUTH_MODE=password
# SECRETS — set with `wrangler secret put`. The hash is PBKDF2 (generate it with
# `npm run cms:hash-admin-password`). ADMIN_USERS is the multi-admin
# alternative to the EMAIL + HASH pair: a JSON array of
# {email, passwordHash, role}. The session secret signs the admin cookie.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_USERS=
ADMIN_SESSION_SECRET=

# Bearer tokens for the outbox endpoints an external automation calls (they sit
# outside the admin session gate). SECRETS. Unset, those endpoints refuse every
# request.
LEAD_OUTBOX_TOKEN=
MAILBOX_OUTBOX_TOKEN=

# Optional outbound delivery for inquiries (CRM, Google Sheet, n8n/Make
# webhook, task system). Leave BOTH unset and the webhook provider stays
# completely inert — no third-party dependency is required for the site to
# work. When set, every inquiry is POSTed as JSON after it has already been
# persisted, and each attempt is recorded in `delivery_attempts`.
LEAD_WEBHOOK_URL=
# Optional shared secret. The Worker signs each POST with it (HMAC-SHA256 of
# "<timestamp>.<body>" in `X-DevLab-Signature`, with `X-DevLab-Timestamp`);
# the secret itself is never sent. See docs/operations.md.
LEAD_WEBHOOK_SECRET=

# Turnstile: leave both unset to use Cloudflare's published testing keys
# (always pass, safe for local dev, NOT real spam protection). See
# docs/operations.md's "Turnstile setup" section to configure real ones.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Maintenance mode is now a runtime D1 toggle, not a build-time env var —
# set the `maintenance_mode` key in the `site_settings` table to `true`/`false`.

# Do not store Cloudflare API tokens in .env.example.
# Set CLOUDFLARE_API_TOKEN only in CI/Cloudflare dashboard secrets.

# Pickleball — Google sign-in for session hosts' DUPR export (see docs/pickleball/runbook.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PICKLEBALL_OAUTH_REDIRECT_BASE_URL=http://localhost:8787
# Never set outside local/CI wrangler dev — enables POST /api/pickleball/open/host/test-login
# and returns the DUPR export email in the response instead of sending it
PICKLEBALL_TEST_AUTH_ENABLED=

# ============================================================================
# Lead Intelligence Engine
# ============================================================================
# EVERY FLAG DEFAULTS TO OFF. With none of these set, the engine is inert: no
# discovery, no crawling, no Workers AI spend, no mailbox polling. The Lead CRM
# screens are reachable and show an explicit "disabled" state.
#
# There is deliberately NO auto-send flag. The Worker has no sending capability
# for prospect email: it collects drafts for a human to approve, and the
# operator's external tooling sends approved drafts. See
# docs/lead-engine/architecture.md.
#
# Set these as Cloudflare Worker vars/secrets, not in a committed file.

# Master switch. Every other flag below is ANDed with this one.
LEAD_ENGINE_ENABLED=false

LEAD_DISCOVERY_ENABLED=false
LEAD_CRAWLER_ENABLED=false
LEAD_AI_ENABLED=false
LEAD_TRACKING_ENABLED=false
# Arms the cron for campaigns that are BOTH active and schedule-enabled.
LEAD_CAMPAIGN_SCHEDULES_ENABLED=false
# Browser rendering fallback for client-rendered sites. Also needs the two
# CLOUDFLARE_*/BROWSER_RENDERING_* values below.
LEAD_BROWSER_RUN_ENABLED=false

# --- Optional discovery source ---------------------------------------------
# Brave Search is entirely optional; the engine works without it and simply
# discovers fewer candidates. SECRET.
BRAVE_SEARCH_API_KEY=

# --- Optional Browser Rendering fallback ------------------------------------
# Used only when a normal HTTP fetch returns an empty shell AND the site is
# clearly client-rendered AND robots.txt permits it. BROWSER_RENDERING_API_TOKEN
# is a SECRET: an account-scoped token with Browser Rendering permissions.
CLOUDFLARE_ACCOUNT_ID=
BROWSER_RENDERING_API_TOKEN=
