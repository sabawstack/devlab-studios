---
import { brandingAssets } from '../config/branding.js'
import { logoFallbackSrc } from '../lib/logoFallback'
import type { SiteSettingsData } from '../lib/content/siteSettings'
import { safeHref } from '../lib/safeHref'

interface Props {
  siteSettings: SiteSettingsData
}

const fallbackLogoSrc = await logoFallbackSrc()
const { siteSettings } = Astro.props
const footer = siteSettings.footer || {}
const canonicalTagline = 'Your Vision, Digitally Crafted — one solution at a time, always evolving.'
const rawTagline = String(footer.tagline || '').trim()
const footerTagline = !rawTagline || /^(?:smoke test|version history) tagline\b/i.test(rawTagline)
  ? canonicalTagline
  : rawTagline.replace(' - ', ' — ')
// safeHref is the render-time half of the CMS link policy (src/lib/safeHref.ts).
const withSafeHrefs = (links: Array<{ label: string; href: string }>) =>
  links.map((link) => ({ ...link, href: safeHref(link.href) }))
const quickLinks = withSafeHrefs(footer.quickLinks || [])
const socialLinks = withSafeHrefs(footer.socialLinks || [])
const legalLinks = footer.legalLinks?.length
  ? withSafeHrefs(footer.legalLinks)
  : [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
    ]

const socialIcon = (label: string) => {
  const key = label.toLowerCase()
  if (key === 'linkedin') return 'linkedin'
  if (key === 'github') return 'github'
  if (key === 'facebook') return 'facebook'
  return 'email'
}
---

<footer class="site-footer relative mt-20 overflow-hidden text-white">
  <div class="absolute inset-x-[12%] top-0 h-px opacity-60 bg-[linear-gradient(90deg,transparent,#c000ff_28%,#4500ff_65%,#0000ff,transparent)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_10%,rgba(104,0,255,0.10),transparent_32%),radial-gradient(circle_at_85%_80%,rgba(0,0,255,0.08),transparent_30%)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-12 text-sm text-slate-300 sm:px-6 lg:px-6">
    <div class="flex flex-col gap-8 text-center md:flex-row md:items-start md:justify-between md:text-left">
      <div class="flex flex-1 flex-col items-center md:items-start">
        <div class="mb-4 flex items-center gap-3">
          <img id="footer-logo" src={brandingAssets.logoOnlyUrl} data-fallback-src={fallbackLogoSrc} alt="" class="h-10 w-10 object-contain" loading="lazy" width="40" height="40" />
          <p class="text-lg font-semibold tracking-tight text-white">{footer.companyName || 'DevLab Studios'}</p>
        </div>
        <p class="mb-3 max-w-md text-slate-400">
          {footerTagline}
        </p>
        <a href={`mailto:${footer.email || 'stpnrey.agustinez@gmail.com'}`} class="mb-1 block text-slate-200 transition hover:text-white hover:underline">
          {footer.email || 'stpnrey.agustinez@gmail.com'}
        </a>
        <span class="block text-slate-400">{footer.location || 'Lapu-Lapu City, Cebu, PH'}</span>
      </div>

      <div class="flex flex-1 flex-col items-center">
        <p class="mb-2 font-semibold text-white">Explore</p>
        <ul>
          {quickLinks.map((item) => (
            <li><a href={item.href} class="inline-block py-2 transition hover:text-white hover:underline">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Hard-coded rather than CMS quick links: a studio product, not site navigation. -->
      <nav class="flex flex-1 flex-col items-center" aria-label="Products">
        <p class="mb-2 font-semibold text-white">Products</p>
        <ul>
          <li><a href="/pickleball?ref=footer" class="inline-block py-2 transition hover:text-white hover:underline">Devlab Pickleball (free)</a></li>
        </ul>
      </nav>

      <div class="flex flex-1 flex-col items-center md:items-end">
        <p class="mb-2 font-semibold text-white">Connect</p>
        <div class="flex flex-wrap justify-center gap-3 md:justify-end">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={item.label}
              class="group inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-2 text-slate-300 transition hover:border-violet-400/40 hover:bg-white/[0.08] hover:text-white"
            >
              {socialIcon(item.label) === 'linkedin' ? (
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#8d9bff] transition group-hover:text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              ) : socialIcon(item.label) === 'github' ? (
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#8d9bff] transition group-hover:text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 2a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4"></path><path d="M8 19c-3 .9-5-1.5-5-1.5"></path></svg>
              ) : socialIcon(item.label) === 'facebook' ? (
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#8d9bff] transition group-hover:text-white" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.75l.41-3H13.5V9.08c0-.87.25-1.46 1.58-1.46h1.69V4.94a22.7 22.7 0 0 0-2.46-.13c-2.43 0-4.1 1.48-4.1 4.2V11H7.46v3h2.75v8h3.29Z"></path></svg>
              ) : (
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-[#8d9bff] transition group-hover:text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              )}
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-4 text-center text-xs text-slate-500 md:flex-row md:items-center md:justify-between md:text-left">
      <span>{footer.copyright || '© 2026 DevLab Studios. All rights reserved.'}</span>
      <span class="flex flex-wrap justify-center gap-x-2 md:justify-end">
        {legalLinks.map((link, index) => (
          <>
            <a href={link.href} class="inline-block py-2 transition hover:text-white hover:underline">{link.label}</a>
            {index < legalLinks.length - 1 ? <span aria-hidden="true" class="self-center">|</span> : null}
          </>
        ))}
      </span>
    </div>
  </div>
</footer>

<script>
  const logo = document.getElementById('footer-logo') as HTMLImageElement | null
  // Same fallback as the navbar logo: swap to the copy bundled with the site,
  // including when the image already failed before this script ran.
  const useFallbackLogo = () => {
    if (logo?.dataset.fallbackSrc && logo.src !== new URL(logo.dataset.fallbackSrc, location.href).href) {
      logo.src = logo.dataset.fallbackSrc
    }
  }
  logo?.addEventListener('error', useFallbackLogo, { once: true })
  if (logo?.complete && logo.naturalWidth === 0 && logo.currentSrc) useFallbackLogo()
</script>
