---
import PrimaryButton from '../PrimaryButton.jsx'
import VectorField from '../VectorField.astro'
import LivingSystems from '../LivingSystems.astro'
import { MessageSquare, CheckCircle2, ArrowRight, Briefcase, Clock, Code2 } from '../icons/icons.js'
import { parseLiteMarkdown } from '../../lib/content/liteMarkdown'
import { loadServicesContent } from '../../lib/content/services'
import { loadProjects } from '../../lib/content/projects'
import { loadCaseStudies } from '../../lib/content/caseStudies'
import { loadArticlesContent } from '../../lib/content/articles'
import { getScene } from '../../config/scenes'
import { getEntryOffer } from '../../config/offers.js'

interface CtaLink {
  label: string
  href: string
}

interface BlockProps {
  eyebrow?: string
  heading?: string
  subheading?: string
  imageUrl?: string
  variant?: 'system' | 'editorial' | 'compact'
  iconMotif?: 'fullstack' | 'automation' | 'data' | 'editorial'
  signals?: string[]
  primaryCta?: CtaLink
  secondaryCta?: CtaLink
  body?: string
  items?: Array<{ label: string; value: string }>
  steps?: Array<{ title: string; description: string; icon?: string }>
  serviceIds?: string[]
  limit?: number
  context?: string
  images?: Array<{ url: string; alt: string }>
  sceneId?: string
  caption?: string
  offerId?: string
  priceLabel?: string
  ctaLabel?: string
}

interface ProofItem {
  label: string
  value: string
  kind: string
  evidenceUrl?: string
}

interface Block {
  type: string
  props: BlockProps
}

interface Props {
  blocks: Block[]
}

const { blocks } = Astro.props as Props
const blockTypes = new Set(blocks.map((block) => block.type))
const servicesContent = blockTypes.has('servicesGrid') || blockTypes.has('faq') ? await loadServicesContent() : null
const projects = blockTypes.has('featuredProjects') ? await loadProjects() : []
const caseStudies = blockTypes.has('featuredCaseStudies') ? await loadCaseStudies() : []
const articles = blockTypes.has('resourceCards') ? (await loadArticlesContent()).posts : []
---

<div class="space-y-10">
  {blocks.map((block) => {
    if (block.type === 'hero') {
      const { eyebrow, heading, subheading, primaryCta, secondaryCta, variant = 'editorial', iconMotif = 'fullstack', signals = [] } = block.props
      return (
        <section class="cinematic-panel relative overflow-hidden rounded-[2rem] p-6 text-white sm:p-8 lg:p-10">
          <VectorField motif={iconMotif as 'fullstack' | 'automation' | 'data' | 'editorial'} />
          <div class:list={["relative z-10 grid gap-8", variant === 'system' ? 'lg:grid-cols-[1.05fr_0.95fr] lg:items-center' : '']}>
            <div class="space-y-5">
              {eyebrow ? <p class="tech-kicker">{eyebrow}</p> : null}
              <h1 class="text-4xl font-semibold leading-tight tracking-[-0.03em] sm:text-5xl">{heading}</h1>
              {subheading ? <p class="max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">{subheading}</p> : null}
              {primaryCta || secondaryCta ? (
                <div class="flex flex-wrap gap-3">
                  {primaryCta ? (
                    <PrimaryButton to={primaryCta.href}>
                      <MessageSquare size={16} />
                      {primaryCta.label}
                    </PrimaryButton>
                  ) : null}
                  {secondaryCta ? <PrimaryButton to={secondaryCta.href} variant="secondary">{secondaryCta.label}</PrimaryButton> : null}
                </div>
              ) : null}
              {Array.isArray(signals) && signals.length ? (
                <div class="flex flex-wrap gap-2 border-t border-white/10 pt-5">
                  {signals.map((signal) => <span class="rounded-full border border-white/10 bg-white/[0.06] px-3 py-1.5 text-xs font-semibold text-slate-300">{signal}</span>)}
                </div>
              ) : null}
            </div>
            {variant === 'system' ? <LivingSystems /> : null}
          </div>
        </section>
      )
    }

    if (block.type === 'richText') {
      const { heading, body } = block.props
      const bodyBlocks = parseLiteMarkdown(body || '')
      return (
        <section class="rounded-[28px] bg-white/90 p-6 shadow-[0_18px_45px_rgba(60,28,120,0.10)] ring-1 ring-slate-200 sm:p-8">
          {heading ? <h2 class="mb-4 text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="prose prose-slate max-w-none">
            {bodyBlocks.map((textBlock) => {
              if (textBlock.type === 'heading') {
                return <h3 class="mt-6 text-xl font-semibold text-brand-ink first:mt-0">{textBlock.text}</h3>
              }
              if (textBlock.type === 'list') {
                return (
                  <ul class="mt-3 grid gap-2 text-slate-700">
                    {textBlock.items.map((item) => (
                      <li class="flex gap-3 leading-relaxed">
                        <CheckCircle2 className="mt-1 h-4 w-4 flex-shrink-0 text-brand-teal" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )
              }
              return <p class="mt-3 leading-relaxed text-slate-700 first:mt-0">{textBlock.text}</p>
            })}
          </div>
        </section>
      )
    }

    if (block.type === 'stats') {
      const { heading, items = [] } = block.props
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {items.map((item) => (
              <article class="light-panel rounded-2xl p-5">
                <p class="text-2xl font-semibold text-brand-ink">{item.value}</p>
                <p class="mt-1 text-sm text-slate-600">{item.label}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'servicesGrid') {
      const { heading, serviceIds = [] } = block.props
      const services = (servicesContent?.solutionGroups || []).filter((service) => !serviceIds.length || serviceIds.includes(service.id))
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-5 md:grid-cols-2">
            {services.map((service) => (
              <article class="light-panel rounded-[1.5rem] p-6">
                <Code2 className="h-5 w-5 text-brand-teal" aria-hidden="true" />
                <h3 class="mt-4 text-xl font-semibold text-brand-ink">{service.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.description}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'featuredProjects') {
      const { heading, limit = 3 } = block.props
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-5 md:grid-cols-3">
            {projects.slice(0, limit).map((project) => (
              <article class="light-panel rounded-[1.5rem] p-5">
                <Briefcase className="h-5 w-5 text-brand-teal" aria-hidden="true" />
                <h3 class="mt-4 font-semibold text-brand-ink">{project.title}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-slate-600">{project.description}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'featuredCaseStudies') {
      const { heading, subheading, limit = 3 } = block.props
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          {subheading ? <p class="max-w-3xl text-slate-600">{subheading}</p> : null}
          <div class="grid gap-5 md:grid-cols-3">
            {caseStudies.slice(0, limit).map((item) => (
              <a href={`/work/${item.slug}`} class="light-panel group rounded-[1.5rem] p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">{item.industry || 'Case Study'}</p>
                <h3 class="mt-3 font-semibold text-brand-ink">{item.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{item.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'resourceCards') {
      const { heading, limit = 3 } = block.props
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-5 md:grid-cols-3">
            {articles.filter((item) => item.status !== 'draft').slice(0, limit).map((item) => (
              <a href={`/insights/${item.slug}`} class="light-panel rounded-[1.5rem] p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">{item.category}</p>
                <h3 class="mt-3 font-semibold text-brand-ink">{item.title}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-slate-600">{item.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'faq') {
      const { heading } = block.props
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-4 md:grid-cols-2">
            {(servicesContent?.faqs || []).map((item) => (
              <article class="light-panel rounded-2xl p-5">
                <h3 class="font-semibold text-brand-ink">{item.question}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'imageGallery') {
      const { heading, images = [] } = block.props
      return (
        <section class="space-y-5">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {images.map((image) => <img src={image.url} alt={image.alt} loading="lazy" class="h-56 w-full rounded-2xl object-cover shadow-lg" />)}
          </div>
        </section>
      )
    }

    if (block.type === 'experienceTimeline') {
      const { heading } = block.props
      return (
        <section class="light-panel rounded-[1.75rem] p-6 sm:p-8">
          <Clock className="h-6 w-6 text-brand-teal" aria-hidden="true" />
          <h2 class="mt-4 text-2xl font-semibold text-brand-ink">{heading || 'Experience'}</h2>
          <p class="mt-2 text-slate-600">Professional experience is maintained on the Profile page.</p>
          <a href="/profile#experience" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-teal">View experience <ArrowRight className="h-4 w-4" /></a>
        </section>
      )
    }

    if (block.type === 'testimonials') {
      const { heading } = block.props
      return (
        <section class="light-panel rounded-[1.75rem] p-6 sm:p-8">
          <MessageSquare className="h-6 w-6 text-brand-teal" aria-hidden="true" />
          <h2 class="mt-4 text-2xl font-semibold text-brand-ink">{heading || 'Client feedback'}</h2>
          <p class="mt-2 text-slate-600">Published testimonials will appear here when they are available.</p>
        </section>
      )
    }

    if (block.type === 'processSteps') {
      const { heading, steps = [] } = block.props
      return (
        <section class="space-y-6">
          {heading ? <h2 class="text-2xl font-semibold text-brand-ink sm:text-3xl">{heading}</h2> : null}
          <div class="grid gap-5 sm:grid-cols-2">
            {steps.map((step, index) => (
              <article class="rounded-[24px] bg-white/[0.92] p-5 shadow-[0_12px_28px_rgba(60,28,120,0.08)] ring-1 ring-slate-200">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-teal">Step {String(index + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-semibold text-brand-ink">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{step.description}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    if (block.type === 'cta') {
      const { heading, body, primaryCta } = block.props
      if ((block.props as { tone?: string }).tone === 'quiet') {
        return (
          <section data-block="cta" data-tone="quiet" class="border-t border-slate-300 pt-6">
            <h2 class="text-xl font-semibold text-slate-900">{heading}</h2>
            {body ? <p class="mt-2 max-w-xl text-slate-600">{body}</p> : null}
            {primaryCta ? <a href={primaryCta.href} class="mt-3 inline-flex min-h-11 items-center font-semibold text-slate-900 underline">{primaryCta.label}</a> : null}
          </section>
        )
      }
      return (
        <section class="rounded-[28px] bg-gradient-to-r from-brand-ink via-[#22185a] to-[#3120a3] p-6 text-white shadow-[0_22px_50px_rgba(20,13,64,0.22)] sm:p-8">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-2xl font-semibold sm:text-3xl">{heading}</h2>
              {body ? <p class="mt-2 max-w-xl text-white/75">{body}</p> : null}
            </div>
            {primaryCta ? (
              <PrimaryButton to={primaryCta.href} showIcon>
                {primaryCta.label}
              </PrimaryButton>
            ) : null}
          </div>
        </section>
      )
    }

    // CMS-03 blocks. Deliberately plain markup: the redesign's styled versions
    // (SceneFrame, ProofStrip, OfferCard) replace these in WEB-04. Scene art is
    // code-owned; until a scene's SVG is approved only its frame and caption show.
    if (block.type === 'scene') {
      const scene = getScene(block.props.sceneId || '')
      if (!scene) return null
      const [w, h] = scene.aspect.wide
      return (
        <section data-block="scene" data-scene-id={scene.id}>
          {block.props.eyebrow ? <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{block.props.eyebrow}</p> : null}
          <h2 class="text-2xl font-semibold text-slate-900 sm:text-3xl">{block.props.heading}</h2>
          {block.props.body ? <p class="mt-3 max-w-2xl text-slate-600">{block.props.body}</p> : null}
          <figure class="mt-6">
            <div class="w-full border border-slate-300" style={`aspect-ratio: ${w} / ${h}`} role="img" aria-label={scene.alt}></div>
            <figcaption class="mt-2 text-sm text-slate-600">{block.props.caption || scene.caption}</figcaption>
          </figure>
        </section>
      )
    }

    if (block.type === 'proofStrip') {
      const items = ((block.props as { items?: ProofItem[] }).items || [])
      return (
        <section data-block="proofStrip">
          {block.props.heading ? <h2 class="text-2xl font-semibold text-slate-900">{block.props.heading}</h2> : null}
          <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {items.map((item) => (
              <div class="border-t border-slate-300 pt-3">
                <dt class="text-sm text-slate-600">{item.label}</dt>
                <dd class="mt-1 font-semibold text-slate-900">
                  {item.evidenceUrl ? <a href={item.evidenceUrl} class="underline">{item.value}</a> : item.value}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    if (block.type === 'offerCard') {
      const offer = getEntryOffer(block.props.offerId || '')
      if (!offer) return null
      const href = `/contact?type=${encodeURIComponent(offer.inquiryType)}&offer=${encodeURIComponent(offer.id)}`
      return (
        <section data-block="offerCard" class="border border-slate-300 p-6">
          <h2 class="text-2xl font-semibold text-slate-900">{block.props.heading || offer.title}</h2>
          <p class="mt-2 text-slate-600">{offer.summary}</p>
          <ul class="mt-4 list-disc space-y-1 pl-5 text-slate-700">
            {offer.includes.map((item: string) => <li>{item}</li>)}
          </ul>
          {block.props.priceLabel ? <p class="mt-4 text-sm text-slate-600">{block.props.priceLabel}</p> : null}
          <a href={href} class="mt-5 inline-flex min-h-11 items-center font-semibold text-slate-900 underline">{block.props.ctaLabel}</a>
        </section>
      )
    }

    return null
  })}
</div>
