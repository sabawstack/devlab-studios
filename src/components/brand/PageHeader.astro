---
/**
 * The opening band of a redesigned page (audit BR.9 / UX-05): eyebrow, the
 * page's single h1, a lead and the actions slot. `ink` gives the graphite hero
 * band (home only, spec N.10), closed by the 3 px gradient rule.
 * A named `aside` slot sits beside the copy from 1024 px.
 */
interface Props {
  eyebrow?: string
  heading: string
  lead?: string
  ink?: boolean
  breadcrumb?: { label: string; href: string }[]
  /** Show the aside (a scene) before the copy on phones (spec H.2: service-line pages, UX-03). */
  asideFirst?: boolean
}
const { eyebrow, heading, lead, ink = false, breadcrumb, asideFirst = false } = Astro.props
const hasAside = Astro.slots.has('aside')
---
<header class={ink ? 'ink-panel' : 'border-b border-dl-rule'}>
  <div class={`mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)] ${hasAside ? 'grid items-center gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]' : ''}`}>
    <div>
      {breadcrumb && breadcrumb.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="label flex flex-wrap gap-2 text-dl-ink-3">
            {breadcrumb.map((crumb) => (
              <li class="after:ml-2 after:content-['/'] last:after:content-none"><a href={crumb.href} class="no-underline">{crumb.label}</a></li>
            ))}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="label text-dl-ink-3">{eyebrow}</p>}
      <h1 class="mt-3 max-w-4xl text-step-4">{heading}</h1>
      {lead && <p class="mt-5 text-step-1 text-dl-ink-2">{lead}</p>}
      {Astro.slots.has('default') && <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3"><slot /></div>}
    </div>
    {hasAside && <div class={asideFirst ? 'order-first lg:order-none' : ''}><slot name="aside" /></div>}
  </div>
  {ink && <div class="hero-rule" aria-hidden="true"></div>}
</header>
