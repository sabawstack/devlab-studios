---
/**
 * The scene symbol library (audit BR.8 / UX-02). Every scene is composed from
 * these sixteen line symbols, drawn on a 48-unit grid with 1.5-unit strokes in
 * the ink colour, so the set reads as one drawing language and inverts on ink
 * panels (everything is currentColor or a brand token).
 *
 * `tone` marks a symbol: `red` for the item that is wrong or must be noticed,
 * `ok` for a verified or connected state (diagrams only). `label` sets a mono
 * caption under the symbol; scene text is limited to such labels.
 */
export type GlyphName =
  | 'inbox' | 'chat' | 'phone' | 'sheet' | 'note' | 'form' | 'ledger' | 'api'
  | 'process' | 'person' | 'clock' | 'warning' | 'check' | 'envelope' | 'retry' | 'stamp'

interface Props {
  name: GlyphName
  x: number
  y: number
  /** Rendered size in scene units (the glyph grid is 48). */
  size?: number
  tone?: 'ink' | 'red' | 'ok'
  label?: string
}

const { name, x, y, size = 48, tone = 'ink', label } = Astro.props
const scale = size / 48
const stroke = tone === 'red' ? 'var(--redline)' : tone === 'ok' ? 'var(--ok)' : 'currentColor'
---

<g transform={`translate(${x} ${y}) scale(${scale})`} fill="none" stroke={stroke} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="draw">
  {name === 'inbox' && (
    <>
      <path d="M6 26 L12 10 H36 L42 26 V38 H6 Z" fill="var(--paper-2)" pathLength="1" />
      <path d="M6 26 H17 L20 31 H28 L31 26 H42" pathLength="1" />
    </>
  )}
  {name === 'chat' && (
    <>
      <path d="M8 10 H40 V32 H22 L14 39 V32 H8 Z" fill="var(--paper-2)" pathLength="1" />
      <path d="M15 19 H33 M15 25 H27" pathLength="1" />
    </>
  )}
  {name === 'phone' && (
    <>
      <rect x="15" y="5" width="18" height="38" rx="3" fill="var(--paper-2)" pathLength="1" />
      <path d="M21 9 H27 M22 38 H26" pathLength="1" />
    </>
  )}
  {name === 'sheet' && (
    <>
      <rect x="7" y="8" width="34" height="32" rx="1" fill="var(--paper-2)" pathLength="1" />
      <path d="M7 16 H41 M7 24 H41 M7 32 H41 M18 8 V40 M30 8 V40" pathLength="1" />
    </>
  )}
  {name === 'note' && (
    <>
      <path d="M9 9 H39 V31 L31 39 H9 Z" fill="var(--paper)" pathLength="1" />
      <path d="M31 39 V31 H39" pathLength="1" />
      <path d="M15 18 H33 M15 24 H27" pathLength="1" />
    </>
  )}
  {name === 'form' && (
    <>
      <rect x="9" y="5" width="30" height="38" rx="1" fill="var(--paper-2)" pathLength="1" />
      <path d="M14 13 H24 M14 17 H34 V22 H14 Z M14 27 H24 M14 31 H34 V36 H14 Z" pathLength="1" />
    </>
  )}
  {name === 'ledger' && (
    <>
      <path d="M8 10 C8 6 40 6 40 10 V38 C40 42 8 42 8 38 Z" fill="var(--paper-2)" pathLength="1" />
      <path d="M8 10 C8 14 40 14 40 10 M8 19 C8 23 40 23 40 19 M8 28 C8 32 40 32 40 28" pathLength="1" />
    </>
  )}
  {name === 'api' && (
    <>
      <path d="M24 5 L41 15 V33 L24 43 L7 33 V15 Z" fill="var(--paper-2)" pathLength="1" />
      <path d="M17 24 H31 M24 17 V31" pathLength="1" />
    </>
  )}
  {name === 'process' && (
    <>
      <rect x="5" y="13" width="38" height="22" rx="6" fill="var(--paper-2)" pathLength="1" />
      <path d="M13 24 H35 M30 19 L35 24 L30 29" pathLength="1" />
    </>
  )}
  {name === 'person' && (
    <>
      <circle cx="24" cy="14" r="7" fill="var(--paper)" pathLength="1" />
      <path d="M10 42 C10 31 16 25 24 25 C32 25 38 31 38 42" fill="var(--paper)" pathLength="1" />
      <rect x="27" y="31" width="9" height="6" rx="1" fill="var(--paper)" pathLength="1" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="24" cy="24" r="17" fill="var(--paper)" pathLength="1" />
      <path d="M24 13 V24 L31 28" pathLength="1" />
    </>
  )}
  {name === 'warning' && (
    <>
      <path d="M24 7 L42 39 H6 Z" fill="var(--paper)" pathLength="1" />
      <path d="M24 19 V29 M24 34 V34.5" pathLength="1" />
    </>
  )}
  {name === 'check' && (
    <>
      <circle cx="24" cy="24" r="16" fill="var(--paper)" pathLength="1" />
      <path d="M16 24 L22 30 L33 18" pathLength="1" />
    </>
  )}
  {name === 'envelope' && (
    <>
      <rect x="6" y="12" width="36" height="25" rx="1" fill="var(--paper-2)" pathLength="1" />
      <path d="M6 13 L24 27 L42 13" pathLength="1" />
    </>
  )}
  {name === 'retry' && (
    <>
      <path d="M36 18 A13 13 0 1 0 37 30" pathLength="1" />
      <path d="M37 9 V18 H28" pathLength="1" />
    </>
  )}
  {name === 'stamp' && (
    <>
      <path d="M18 8 H30 V18 L36 24 V30 H12 V24 L18 18 Z" fill="var(--paper-2)" pathLength="1" />
      <path d="M9 36 H39 M12 41 H36" pathLength="1" />
    </>
  )}
  {label && (
    <text x="24" y="58" text-anchor="middle" fill={stroke} stroke="none" font-family="var(--font-label)" font-size="7.5" letter-spacing="0.6">{label}</text>
  )}
</g>
