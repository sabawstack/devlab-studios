---
/**
 * §03 Production systems (ADR 0014): specification cards for up to three CMS
 * Work entries plus the live product, four cards at most. Each card shows the
 * system category, the problem it closes, its stack as tags (allowed on the
 * home page; still forbidden on /solutions) and one link to the write-up.
 */
import type { WorkEntry } from '../../lib/content/work'
import { HOME, PRODUCTS } from '../../data/site/content.js'

interface Props { entries: WorkEntry[] }
const { entries } = Astro.props
const copy = HOME.work
const cards = [
  ...entries.slice(0, 3).map((entry) => ({
    id: entry.slug,
    badge: entry.project.type,
    title: entry.project.title,
    text: entry.problem,
    tags: (entry.project.techStack ?? []).slice(0, 4),
    href: `/work/${entry.slug}`,
    linkLabel: copy.linkLabel,
    ctaId: 'home-work-item',
  })),
  {
    id: 'product-live',
    badge: copy.productBadge,
    title: PRODUCTS.live.title,
    text: PRODUCTS.live.text,
    tags: [] as string[],
    href: PRODUCTS.live.href,
    linkLabel: copy.productLinkLabel,
    ctaId: 'home-work-product',
  },
].slice(0, 4)
---
<ul class="mt-10 grid gap-4 md:grid-cols-2">
  {cards.map((card, position) => (
    <li class="dl-gradient-border flex flex-col p-6" data-system-card={card.id}>
      <div class="flex items-center justify-between gap-3">
        <span class="label rounded-dl-xs border border-dl-rule px-2 py-0.5 text-dl-amber">{card.badge}</span>
        <span class="label text-dl-ink-3" aria-hidden="true">SYS-{String(position + 1).padStart(2, '0')}</span>
      </div>
      <h3 class="mt-5 text-step-1">{card.title}</h3>
      <p class="mt-3 text-dl-ink-2">{card.text}</p>
      {card.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Stack">
          {card.tags.map((tag) => <li class="label rounded-dl-xs bg-dl-paper px-2 py-0.5 text-dl-ink-3">{tag}</li>)}
        </ul>
      )}
      <a href={card.href} class="dl-button-quiet mt-auto self-start pt-6" data-cta-id={card.ctaId}>
        {card.linkLabel}<span class="sr-only">: {card.title}</span>
      </a>
    </li>
  ))}
</ul>
