---
/**
 * The scenes (audit BR.8, S1-S6; spec H.1, S7-S8) and the per-project system
 * diagrams (D-1…D-4), composed from the Glyph library. Each has a wide
 * (desktop) drawing and, where the composition needs one, a tall 4:5 phone
 * drawing (`crop="tall"`). Each
 * draws a real operational situation; text inside the art is limited to short
 * mono labels whose meaning is in the HTML caption. Strokes are currentColor
 * or brand tokens, so every scene inverts on an ink panel.
 *
 * Status: drawn in code, PENDING OWNER APPROVAL (docs/brand/scenes.md). Until
 * a scene's `artReady` is set in src/config/scenes.ts the public SceneFrame
 * shows its frame and caption only; the brand review page shows the art.
 */
import Glyph from './Glyph.astro'
import { getScene } from '../../config/scenes'

interface Props {
  sceneId: string
  /** Element id prefix, unique per page, for the title/desc references. */
  idPrefix?: string
  /** The wide (desktop) or tall 4:5 (phone) drawing. */
  crop?: 'wide' | 'tall'
}

const { sceneId, crop = 'wide', idPrefix: basePrefix = `scene-${sceneId}` } = Astro.props
const scene = getScene(sceneId)
const tall = crop === 'tall' && Boolean(scene?.tall)
const idPrefix = tall ? `${basePrefix}-tall` : basePrefix
const [w, h] = scene ? (tall ? scene.aspect.tall : scene.aspect.wide) : [3, 2]
const width = tall ? 480 : 600
const height = Math.round((width * h) / w)
const wide = !tall
const line = { stroke: 'currentColor', 'stroke-width': 1.5, fill: 'none', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const
const dashed = { ...line, 'stroke-dasharray': '4 5' } as const
const arrowHead = (x: number, y: number, dir: 'right' | 'down' | 'left' | 'up' = 'right') => {
  const d = { right: `M${x - 7} ${y - 5} L${x} ${y} L${x - 7} ${y + 5}`, left: `M${x + 7} ${y - 5} L${x} ${y} L${x + 7} ${y + 5}`, down: `M${x - 5} ${y - 7} L${x} ${y} L${x + 5} ${y - 7}`, up: `M${x - 5} ${y + 7} L${x} ${y} L${x + 5} ${y + 7}` }[dir]
  return d
}
type Step = { glyph: 'inbox' | 'chat' | 'phone' | 'sheet' | 'note' | 'form' | 'ledger' | 'api' | 'process' | 'person' | 'clock' | 'warning' | 'check' | 'envelope' | 'retry' | 'stamp'; label: string; tone?: 'ink' | 'red' | 'ok'; badge?: 'check' | 'stamp' }
/** Linear systems (S8 and the project diagrams), drawn left to right (wide) or top to bottom (tall). */
const CHAINS: Record<string, Step[]> = {
  'the-receipt': [
    { glyph: 'form', label: 'INQUIRY' },
    { glyph: 'ledger', label: 'SAVED', badge: 'stamp' },
    { glyph: 'envelope', label: 'RECEIPT' },
    { glyph: 'person', label: 'A PERSON' },
  ],
  'diagram-memory-preview': [
    { glyph: 'chat', label: 'CHATGPT' },
    { glyph: 'api', label: 'MCP BRIDGE' },
    { glyph: 'process', label: 'CHECKS' },
    { glyph: 'person', label: 'APPROVER', badge: 'stamp' },
    { glyph: 'ledger', label: 'GITHUB' },
  ],
  'diagram-lead-qualification': [
    { glyph: 'process', label: 'INTAKE' },
    { glyph: 'phone', label: 'AI CALL' },
    { glyph: 'api', label: 'CALL HOOK' },
    { glyph: 'ledger', label: 'LEAD RECORD' },
    { glyph: 'person', label: 'ACQUISITION' },
  ],
  'diagram-buyer-intelligence': [
    { glyph: 'form', label: 'DEAL' },
    { glyph: 'api', label: 'GEOCODE' },
    { glyph: 'ledger', label: 'ADDR CACHE' },
    { glyph: 'process', label: 'AI RANK' },
    { glyph: 'sheet', label: 'BUYER SHEET' },
    { glyph: 'person', label: 'REVIEW' },
  ],
  'diagram-messenger-agent': [
    { glyph: 'chat', label: 'MESSAGE' },
    { glyph: 'process', label: 'FILTER' },
    { glyph: 'api', label: 'CONTEXT' },
    { glyph: 'note', label: 'AI REPLY' },
    { glyph: 'api', label: 'ACTIONS' },
    { glyph: 'chat', label: 'REPLY' },
  ],
}
const chain = scene ? CHAINS[scene.id] : undefined
/** Chain glyph size: larger when there are fewer steps, so the drawing fills its frame. */
const G = !chain ? 52 : chain.length <= 4 ? 76 : chain.length === 5 ? 64 : 56
const chainAt = (index: number, count: number) => tall
  ? { x: width / 2 - G / 2, y: 24 + index * ((height - 60 - G) / Math.max(count - 1, 1)) }
  : { x: 24 + index * ((width - 48 - G) / Math.max(count - 1, 1)), y: height / 2 - G / 2 - 10 }
const channels = [
  { name: 'form', label: 'WEB FORM' },
  { name: 'envelope', label: 'EMAIL' },
  { name: 'chat', label: 'CHAT' },
  { name: 'phone', label: 'PHONE' },
] as const
---

{scene && (
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-labelledby={`${idPrefix}-title ${idPrefix}-desc`}
    class="scene-art block h-auto w-full text-dl-ink"
    data-scene={scene.id}
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={`${idPrefix}-title`}>{scene.title}</title>
    <desc id={`${idPrefix}-desc`}>{scene.alt}</desc>

    {wide && scene.id === 'fragmented-intake' && (
      <g>
        {channels.map((channel, i) => (
          <>
            <Glyph name={channel.name} x={40} y={30 + i * 88} label={channel.label} />
            <path d={`M100 ${54 + i * 88} C 200 ${54 + i * 88 + (i % 2 ? 24 : -18)}, 300 ${54 + i * 88 + (i % 2 ? -20 : 22)}, 400 ${54 + i * 88}`} {...dashed} />
          </>
        ))}
        <Glyph name="inbox" x={410} y={30} label="SHARED INBOX" />
        <Glyph name="sheet" x={410} y={118} label="SPREADSHEET" />
        <Glyph name="chat" x={410} y={206} label="DM THREAD" />
        <Glyph name="note" x={410} y={294} label="SOMEONE'S NOTE" />
        <Glyph name="clock" x={515} y={30} size={44} tone="red" label="AFTER HOURS" />
        <g class="draw">
          <rect x={490} y={262} width={96} height={52} rx={2} fill="var(--paper)" stroke="var(--redline)" stroke-width="1.5" pathLength="1" />
          <text x={538} y={285} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="9" letter-spacing="0.5">WHO OWNS</text>
          <text x={538} y={299} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="9" letter-spacing="0.5">THIS?</text>
        </g>
      </g>
    )}

    {wide && scene.id === 'connected-system' && (
      <g>
        {channels.map((channel, i) => (
          <>
            <Glyph name={channel.name} x={40} y={30 + i * 88} label={channel.label} />
            <path d={`M100 ${54 + i * 88} C 170 ${54 + i * 88}, 190 200, 238 200`} {...line} class="draw" pathLength="1" />
          </>
        ))}
        <path d={arrowHead(240, 200)} {...line} class="draw" pathLength="1" />
        <g class="draw">
          <rect x={248} y={120} width={150} height={160} rx={4} fill="var(--paper-2)" stroke="currentColor" stroke-width="1.5" pathLength="1" />
          <text x={262} y={142} fill="currentColor" font-family="var(--font-label)" font-size="9" letter-spacing="0.6">INQUIRY LEDGER</text>
          {[0, 1, 2].map((row) => (
            <>
              <path d={`M262 ${162 + row * 36} H384`} stroke="var(--rule)" stroke-width="1" />
              <rect x={262} y={168 + row * 36} width={44} height={14} rx={2} fill="var(--paper)" stroke="currentColor" stroke-width="1" />
              <text x={284} y={178 + row * 36} text-anchor="middle" fill="currentColor" font-family="var(--font-label)" font-size="7">{['NEW', 'REPLIED', 'BOOKED'][row]}</text>
              <text x={314} y={178 + row * 36} fill="currentColor" font-family="var(--font-label)" font-size="7">OWNER: {['ANA', 'BEN', 'ANA'][row]}</text>
            </>
          ))}
        </g>
        <path d="M398 200 H458" {...line} class="draw" pathLength="1" />
        <path d={arrowHead(460, 200)} {...line} class="draw" pathLength="1" />
        <Glyph name="person" x={470} y={170} size={60} label="ANA · OWNER" />
        <Glyph name="check" x={530} y={150} size={34} tone="ok" />
      </g>
    )}

    {wide && scene.id === 'persist-before-deliver' && (
      <g>
        <Glyph name="form" x={30} y={120} label="SUBMISSION" />
        <path d="M86 144 H140" {...line} class="draw" pathLength="1" />
        <path d={arrowHead(142, 144)} {...line} class="draw" pathLength="1" />
        <Glyph name="ledger" x={150} y={112} size={64} label="1 · SAVED FIRST" />
        <path d="M222 144 C 262 144, 262 60, 300 60 M222 144 H300 M222 144 C 262 144, 262 228, 300 228" {...line} class="draw" pathLength="1" />
        <Glyph name="envelope" x={308} y={36} label="EMAIL" />
        <Glyph name="check" x={368} y={40} size={36} tone="ok" />
        <Glyph name="process" x={308} y={120} label="CRM" />
        <Glyph name="check" x={368} y={124} size={36} tone="ok" />
        <Glyph name="api" x={308} y={204} label="WEBHOOK" tone="red" />
        <Glyph name="warning" x={368} y={206} size={36} tone="red" />
        <Glyph name="retry" x={410} y={206} size={36} tone="red" label="RETRY" />
        <g class="draw">
          <rect x={460} y={70} width={120} height={180} rx={4} fill="var(--paper-2)" stroke="currentColor" stroke-width="1.5" pathLength="1" />
          <text x={472} y={92} fill="currentColor" font-family="var(--font-label)" font-size="8.5" letter-spacing="0.6">DELIVERY LOG</text>
          {[0, 1, 2, 3].map((row) => (
            <path d={`M472 ${112 + row * 30} H568`} stroke={row === 2 ? 'var(--redline)' : 'var(--rule)'} stroke-width={row === 2 ? 2 : 1} />
          ))}
          <text x={472} y={166} fill="var(--redline)" font-family="var(--font-label)" font-size="7.5">WEBHOOK · FAILED</text>
        </g>
      </g>
    )}

    {wide && scene.id === 'handoff-to-person' && (
      <g transform="translate(57 40)">
        <Glyph name="process" x={40} y={80} label="AUTOMATED" />
        <path d="M96 104 H196" {...line} class="draw" pathLength="1" />
        <Glyph name="warning" x={200} y={80} tone="red" label="UNCLEAR CASE" />
        <path d="M256 104 H420" {...dashed} />
        <path d={arrowHead(422, 104)} {...line} class="draw" pathLength="1" />
        <Glyph name="process" x={430} y={80} label="CONTINUES" />
        <path d="M224 140 V300" {...line} class="draw" pathLength="1" />
        <path d={arrowHead(224, 302, 'down')} {...line} class="draw" pathLength="1" />
        <Glyph name="person" x={190} y={310} size={68} label="NAMED APPROVER" />
        <Glyph name="stamp" x={290} y={330} size={56} tone="ok" label="APPROVED" />
        <path d="M350 360 C 420 360, 460 300, 458 160" {...line} class="draw" pathLength="1" />
        <path d={arrowHead(458, 158, 'up')} {...line} class="draw" pathLength="1" />
      </g>
    )}

    {wide && scene.id === 'build-in-layers' && (
      <g>
        {['INTERFACE', 'SERVICES / API', 'DATA', 'AUTOMATION', 'PEOPLE / HANDOFF'].map((name, i) => (
          <g class="draw">
            <rect x={70} y={22 + i * 64} width={460} height={44} rx={4} fill={i % 2 ? 'var(--paper)' : 'var(--paper-2)'} stroke="currentColor" stroke-width="1.5" pathLength="1" />
            <text x={86} y={49 + i * 64} fill="currentColor" font-family="var(--font-label)" font-size="10" letter-spacing="0.8">{name}</text>
            {i < 4 && [200, 300, 400].map((jx) => (
              <path d={`M${jx} ${66 + i * 64} V${86 + i * 64}`} stroke="currentColor" stroke-width="1.5" />
            ))}
          </g>
        ))}
        <Glyph name="form" x={470} y={20} size={44} />
        <Glyph name="api" x={470} y={84} size={44} />
        <Glyph name="ledger" x={470} y={148} size={44} />
        <Glyph name="process" x={470} y={212} size={44} />
        <Glyph name="person" x={470} y={276} size={44} />
      </g>
    )}

    {wide && scene.id === 'workflow-audit' && (
      <g>
        {[0, 1, 2, 3, 4].map((i) => (
          <>
            <Glyph name={(['form', 'inbox', 'process', 'sheet', 'person'] as const)[i]} x={20 + i * 76} y={150} size={48} />
            {i < 4 && <path d={`M${72 + i * 76} 174 H${92 + i * 76}`} {...line} class="draw" pathLength="1" />}
          </>
        ))}
        {[{ cx: 120, n: 1 }, { cx: 196, n: 2 }, { cx: 272, n: 3 }].map((mark) => (
          <g class="draw">
            <circle cx={mark.cx} cy={174} r={30} fill="none" stroke="var(--redline)" stroke-width="2" stroke-dasharray="3 3" />
            <circle cx={mark.cx + 24} cy={142} r={10} fill="var(--paper)" stroke="var(--redline)" stroke-width="1.5" />
            <text x={mark.cx + 24} y={146} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="10">{mark.n}</text>
          </g>
        ))}
        <g class="draw">
          <rect x={420} y={70} width={160} height={210} rx={4} fill="var(--paper-2)" stroke="currentColor" stroke-width="1.5" pathLength="1" />
          <text x={434} y={94} fill="currentColor" font-family="var(--font-label)" font-size="8.5" letter-spacing="0.6">RECOMMENDED,</text>
          <text x={434} y={108} fill="currentColor" font-family="var(--font-label)" font-size="8.5" letter-spacing="0.6">IN PRIORITY ORDER</text>
          {[1, 2, 3].map((n) => (
            <>
              <circle cx={444} cy={124 + n * 40} r={9} fill="var(--paper)" stroke="var(--redline)" stroke-width="1.5" />
              <text x={444} y={128 + n * 40} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="9">{n}</text>
              <path d={`M462 ${120 + n * 40} H566 M462 ${130 + n * 40} H530`} stroke="currentColor" stroke-width="1.5" />
            </>
          ))}
        </g>
      </g>
    )}
    {tall && scene.id === 'fragmented-intake' && (
      <g>
        {channels.map((channel, i) => {
          const to = [2, 0, 3, 1][i]
          return (
            <>
              <Glyph name={channel.name} x={30 + i * 112} y={24} label={channel.label} />
              <path d={`M${54 + i * 112} 100 C ${54 + i * 112} 200, ${54 + to * 112} 220, ${54 + to * 112} 300`} {...dashed} />
            </>
          )
        })}
        <Glyph name="inbox" x={30} y={310} label="SHARED INBOX" />
        <Glyph name="sheet" x={142} y={310} label="SPREADSHEET" />
        <Glyph name="chat" x={254} y={310} label="DM THREAD" />
        <Glyph name="note" x={366} y={310} label="A NOTE" />
        <Glyph name="clock" x={60} y={448} size={56} tone="red" label="AFTER HOURS" />
        <g class="draw">
          <rect x={200} y={452} width={220} height={60} rx={2} fill="var(--paper)" stroke="var(--redline)" stroke-width="1.5" pathLength="1" />
          <text x={310} y={488} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="11" letter-spacing="0.5">WHO OWNS THIS?</text>
        </g>
      </g>
    )}

    {tall && scene.id === 'connected-system' && (
      <g>
        {channels.map((channel, i) => (
          <>
            <Glyph name={channel.name} x={30 + i * 112} y={24} label={channel.label} />
            <path d={`M${54 + i * 112} 100 C ${54 + i * 112} 150, 240 150, 240 186`} {...line} class="draw" pathLength="1" />
          </>
        ))}
        <path d={arrowHead(240, 194, 'down')} {...line} class="draw" pathLength="1" />
        <g class="draw">
          <rect x={130} y={200} width={220} height={170} rx={4} fill="var(--paper-2)" stroke="currentColor" stroke-width="1.5" pathLength="1" />
          <text x={146} y={224} fill="currentColor" font-family="var(--font-label)" font-size="10" letter-spacing="0.6">INQUIRY LEDGER</text>
          {[0, 1, 2].map((row) => (
            <>
              <path d={`M146 ${244 + row * 38} H334`} stroke="var(--rule)" stroke-width="1" />
              <rect x={146} y={252 + row * 38} width={56} height={16} rx={2} fill="var(--paper)" stroke="currentColor" stroke-width="1" />
              <text x={174} y={263 + row * 38} text-anchor="middle" fill="currentColor" font-family="var(--font-label)" font-size="8">{['NEW', 'REPLIED', 'BOOKED'][row]}</text>
              <text x={214} y={263 + row * 38} fill="currentColor" font-family="var(--font-label)" font-size="8">OWNER: {['ANA', 'BEN', 'ANA'][row]}</text>
            </>
          ))}
        </g>
        <path d="M240 370 V430" {...line} class="draw" pathLength="1" />
        <path d={arrowHead(240, 438, 'down')} {...line} class="draw" pathLength="1" />
        <Glyph name="person" x={206} y={444} size={68} label="ANA · OWNER" />
        <Glyph name="check" x={282} y={436} size={40} tone="ok" />
      </g>
    )}

    {tall && scene.id === 'persist-before-deliver' && (
      <g>
        <Glyph name="form" x={40} y={30} label="SUBMISSION" />
        <path d="M96 54 H170" {...line} class="draw" pathLength="1" />
        <path d={arrowHead(176, 54)} {...line} class="draw" pathLength="1" />
        <Glyph name="ledger" x={184} y={22} size={64} label="1 · SAVED FIRST" />
        <path d="M216 120 V354 M216 174 H170 M216 264 H170 M216 354 H170" {...line} class="draw" pathLength="1" />
        <Glyph name="envelope" x={116} y={150} label="EMAIL" />
        <Glyph name="check" x={240} y={154} size={36} tone="ok" />
        <Glyph name="process" x={116} y={240} label="CRM" />
        <Glyph name="check" x={240} y={244} size={36} tone="ok" />
        <Glyph name="api" x={116} y={330} label="WEBHOOK" tone="red" />
        <Glyph name="warning" x={240} y={332} size={36} tone="red" />
        <Glyph name="retry" x={286} y={332} size={36} tone="red" label="RETRY" />
        <g class="draw">
          <rect x={60} y={440} width={360} height={130} rx={4} fill="var(--paper-2)" stroke="currentColor" stroke-width="1.5" pathLength="1" />
          <text x={76} y={464} fill="currentColor" font-family="var(--font-label)" font-size="10" letter-spacing="0.6">DELIVERY LOG</text>
          {[0, 1, 2].map((row) => (
            <path d={`M76 ${484 + row * 28} H404`} stroke={row === 2 ? 'var(--redline)' : 'var(--rule)'} stroke-width={row === 2 ? 2 : 1} />
          ))}
          <text x={76} y={534} fill="var(--redline)" font-family="var(--font-label)" font-size="9">WEBHOOK · FAILED · RETRYING</text>
        </g>
      </g>
    )}

    {tall && scene.id === 'workflow-audit' && (
      <g>
        {[0, 1, 2, 3, 4].map((i) => (
          <>
            <Glyph name={(['form', 'inbox', 'process', 'sheet', 'person'] as const)[i]} x={30 + i * 86} y={90} size={48} />
            {i < 4 && <path d={`M${82 + i * 86} 114 H${112 + i * 86}`} {...line} class="draw" pathLength="1" />}
          </>
        ))}
        {[1, 2, 3].map((n) => (
          <g class="draw">
            <circle cx={54 + n * 86} cy={114} r={32} fill="none" stroke="var(--redline)" stroke-width="2" stroke-dasharray="3 3" />
            <circle cx={78 + n * 86} cy={80} r={11} fill="var(--paper)" stroke="var(--redline)" stroke-width="1.5" />
            <text x={78 + n * 86} y={84} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="11">{n}</text>
          </g>
        ))}
        <g class="draw">
          <rect x={80} y={240} width={320} height={300} rx={4} fill="var(--paper-2)" stroke="currentColor" stroke-width="1.5" pathLength="1" />
          <text x={100} y={272} fill="currentColor" font-family="var(--font-label)" font-size="11" letter-spacing="0.6">RECOMMENDED,</text>
          <text x={100} y={290} fill="currentColor" font-family="var(--font-label)" font-size="11" letter-spacing="0.6">IN PRIORITY ORDER</text>
          {[1, 2, 3].map((n) => (
            <>
              <circle cx={112} cy={290 + n * 60} r={12} fill="var(--paper)" stroke="var(--redline)" stroke-width="1.5" />
              <text x={112} y={294 + n * 60} text-anchor="middle" fill="var(--redline)" font-family="var(--font-label)" font-size="11">{n}</text>
              <path d={`M136 ${284 + n * 60} H380 M136 ${298 + n * 60} H320`} stroke="currentColor" stroke-width="1.5" />
            </>
          ))}
        </g>
      </g>
    )}

    {scene.id === 'human-controlled-automation' && (
      wide ? (
        <g>
          <path d="M80 104 H520" {...line} class="draw" pathLength="1" />
          {[0, 1, 2, 3, 4].map((i) => (
            <>
              <Glyph name="process" x={30 + i * 116} y={80} label={['INTAKE', 'SORT', 'EXCEPTION', 'SEND', 'RECORD'][i]} tone={i === 2 ? 'red' : 'ink'} />
              {i !== 2 && <Glyph name="check" x={62 + i * 116} y={48} size={28} tone="ok" />}
            </>
          ))}
          <Glyph name="warning" x={262} y={44} size={30} tone="red" />
          <path d="M262 140 C 262 200, 220 230, 220 262" {...line} class="draw" pathLength="1" />
          <path d={arrowHead(220, 268, 'down')} {...line} class="draw" pathLength="1" />
          <Glyph name="person" x={186} y={272} size={68} label="NAMED REVIEWER" />
          <Glyph name="stamp" x={292} y={290} size={52} tone="ok" label="APPROVED" />
          <path d="M348 316 C 390 316, 396 220, 396 146" {...line} class="draw" pathLength="1" />
          <path d={arrowHead(396, 140, 'up')} {...line} class="draw" pathLength="1" />
        </g>
      ) : (
        <g>
          <path d="M84 70 V530" {...line} class="draw" pathLength="1" />
          {[0, 1, 2, 3, 4].map((i) => (
            <>
              <Glyph name="process" x={60} y={30 + i * 110} label={['INTAKE', 'SORT', 'EXCEPTION', 'SEND', 'RECORD'][i]} tone={i === 2 ? 'red' : 'ink'} />
              {i !== 2 && <Glyph name="check" x={118} y={34 + i * 110} size={30} tone="ok" />}
            </>
          ))}
          <Glyph name="warning" x={118} y={256} size={32} tone="red" />
          <path d="M112 274 C 180 274, 200 250, 236 250" {...line} class="draw" pathLength="1" />
          <path d={arrowHead(242, 250)} {...line} class="draw" pathLength="1" />
          <Glyph name="person" x={248} y={216} size={68} label="NAMED REVIEWER" />
          <Glyph name="stamp" x={376} y={234} size={52} tone="ok" label="APPROVED" />
          <path d="M402 304 C 402 360, 200 370, 116 370" {...line} class="draw" pathLength="1" />
          <path d={arrowHead(110, 370, 'left')} {...line} class="draw" pathLength="1" />
        </g>
      )
    )}

    {chain && (
      <g>
        {chain.map((step, i) => {
          const at = chainAt(i, chain.length)
          const next = i < chain.length - 1 ? chainAt(i + 1, chain.length) : null
          return (
            <>
              <Glyph name={step.glyph} x={at.x} y={at.y} size={G} tone={step.tone ?? 'ink'} label={step.label} />
              {step.badge && <Glyph name={step.badge} x={at.x + G - 12} y={at.y - 14} size={28} tone="ok" />}
              {next && (tall
                ? <><path d={`M${width / 2} ${at.y + G + 18} V${next.y - 8}`} {...line} class="draw" pathLength="1" /><path d={arrowHead(width / 2, next.y - 4, 'down')} {...line} class="draw" pathLength="1" /></>
                : <><path d={`M${at.x + G + 4} ${at.y + G / 2} H${next.x - 8}`} {...line} class="draw" pathLength="1" /><path d={arrowHead(next.x - 4, at.y + G / 2)} {...line} class="draw" pathLength="1" /></>)}
            </>
          )
        })}
      </g>
    )}
  </svg>
)}
