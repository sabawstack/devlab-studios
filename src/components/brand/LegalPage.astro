---
/**
 * Legal pages on the brand layout (audit G.1 privacy/terms): the CMS page's
 * hero and richText blocks, set as a long-form document with a contents list.
 * The copy stays editable in the CMS; only the presentation is code-owned.
 */
import BrandLayout from '../../layouts/BrandLayout.astro'
import PageHeader from './PageHeader.astro'
import { parseLiteMarkdown } from '../../lib/content/liteMarkdown'
import type { PageData } from '../../lib/content/pages'
import type { SeoData } from '../../lib/content/seo'

interface Props { page: PageData | null; fallbackTitle: string; seo: SeoData | null }
const { page, fallbackTitle, seo } = Astro.props
const hero = page?.blocks.find((block) => block.type === 'hero')?.props || {}
const sections = (page?.blocks || [])
  .filter((block) => block.type === 'richText')
  .map((block, index) => ({
    id: `section-${index + 1}`,
    heading: String(block.props.heading || ''),
    body: parseLiteMarkdown(String(block.props.body || '')),
  }))
const heading = String(hero.heading || page?.title || fallbackTitle)
---

<BrandLayout title={`${page?.title || fallbackTitle} · DevLab Studios`} seo={seo}>
  <PageHeader eyebrow={String(hero.eyebrow || 'Legal')} heading={heading} lead={hero.subheading ? String(hero.subheading) : undefined} />
  <div class="mx-auto grid max-w-container gap-12 px-[var(--gutter)] py-12 lg:grid-cols-[14rem_minmax(0,1fr)]">
    {sections.filter((section) => section.heading).length > 1 && (
      <nav aria-label="On this page" class="lg:sticky lg:top-8 lg:self-start">
        <p class="label text-dl-ink-3">On this page</p>
        <ol class="mt-3 grid gap-2 text-step--1">
          {sections.filter((section) => section.heading).map((section) => <li><a href={`#${section.id}`} class="no-underline hover:underline">{section.heading}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="max-w-[68ch]">
      {page ? sections.map((section) => (
        <section id={section.id} class="scroll-mt-8 border-t border-dl-rule py-8 first:border-t-0 first:pt-0">
          {section.heading && <h2 class="text-step-2">{section.heading}</h2>}
          {section.body.map((block) => {
            if (block.type === 'heading') return <h3 class="mt-6 text-step-1">{block.text}</h3>
            if (block.type === 'list') return <ul class="mt-3 grid list-[square] gap-1.5 pl-5 text-dl-ink-2">{block.items.map((item) => <li>{item}</li>)}</ul>
            return <p class="mt-3 text-dl-ink-2">{block.text}</p>
          })}
        </section>
      )) : <p class="text-dl-ink-2">This page is not available right now.</p>}
      <slot />
    </div>
  </div>
</BrandLayout>
