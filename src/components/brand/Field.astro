---
/**
 * Form field shell (spec N.5): sentence-case label above in the text face,
 * a 44 px white control with a hairline, helper text in ink-3, the error in
 * --danger with the warning symbol and text, 2 px ink on focus. Put the input/select/textarea in the slot with class "dl-control"
 * and pass its id.
 */
interface Props { id: string; label: string; help?: string; error?: string; class?: string }
const { id, label, help, error, class: className = '' } = Astro.props
const describedBy = [help && `${id}-help`, error && `${id}-error`].filter(Boolean).join(' ')
---
<div class={`dl-field ${error ? 'dl-field--error' : ''} ${className}`} data-described-by={describedBy || undefined}>
  <label for={id} class="label mb-1.5 block text-dl-ink">{label}</label>
  <slot />
  {help && <p id={`${id}-help`} class="mt-1.5 text-step--1 text-dl-ink-3">{help}</p>}
  {error && <p id={`${id}-error`} class="mt-1.5 flex items-center gap-1.5 text-step--1 text-dl-danger"><span aria-hidden="true">⚠</span>{error}</p>}
</div>

<style>
  .dl-field :global(.dl-control) {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xs);
    background: var(--paper-2);
    color: var(--ink);
    padding: 0 0.75rem;
    font: inherit;
  }
  .dl-field :global(textarea.dl-control) { padding: 0.75rem; min-height: 8rem; }
  .dl-field :global(.dl-control:focus-visible) { border-color: var(--ink); outline: 2px solid var(--ink); outline-offset: 0; }
  .dl-field--error :global(.dl-control) { border-color: var(--danger); }
</style>
