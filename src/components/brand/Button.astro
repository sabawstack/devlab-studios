---
/**
 * Brand button / link-button. Wraps the global action classes in brand.css so
 * a button and a plain link look the same: `primary` (brand gradient under a
 * navy scrim), `outline` (technical outline) and `quiet` (underlined text).
 * 44 px minimum target, mono label. Renders an <a> when `href` is set.
 */
interface Props {
  href?: string
  variant?: 'primary' | 'outline' | 'quiet'
  type?: 'button' | 'submit'
  disabled?: boolean
  class?: string
  [key: string]: unknown
}
const { href, variant = 'primary', type = 'button', disabled = false, class: className = '', ...rest } = Astro.props
const classes = [`dl-button-${variant}`, 'dl-button', className].join(' ')
---
{href && !disabled
  ? <a href={href} class={classes} {...rest}><slot /></a>
  : <button type={type} class={classes} disabled={disabled} {...rest}><slot /></button>}

<style>
  .dl-button { cursor: pointer; }
  .dl-button:disabled {
    cursor: not-allowed;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    color: var(--ink-3);
  }
</style>
