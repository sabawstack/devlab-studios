---
/** Up to four verifiable proof items in a hairline row (audit BR.10 / CMS-03 proofStrip). */
interface Item { label: string; value: string; kind: 'credential' | 'system' | 'principle'; evidenceUrl?: string }
interface Props { items: Item[]; heading?: string; class?: string }
const { items, heading, class: className = '' } = Astro.props
const kindLabel = { credential: 'Credential', system: 'System', principle: 'Principle' }
---
<section class={className}>
  {heading && <h2 class="text-step-2 text-dl-ink">{heading}</h2>}
  <dl class={`grid border-y border-dl-rule sm:grid-cols-2 lg:grid-cols-4 ${heading ? 'mt-6' : ''}`}>
    {items.slice(0, 4).map((item) => (
      <div class="border-b border-dl-rule p-4 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0">
        <dt class="label text-dl-ink-3">{kindLabel[item.kind]}</dt>
        <dd class="mt-2 text-step-1 font-semibold text-dl-ink">
          {item.evidenceUrl ? <a href={item.evidenceUrl}>{item.value}</a> : item.value}
        </dd>
        <dd class="mt-1 text-step--1 text-dl-ink-2">{item.label}</dd>
      </div>
    ))}
  </dl>
</section>
