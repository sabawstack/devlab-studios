---
/**
 * How an inquiry moves through a DevLab system (spec H.2 screen 3, UX-02):
 * the inquiry flow as an illustration inside an Exhibit, labelled as one.
 * "Show what happens when a webhook fails" flips the root's data-state
 * between nominal and outage, client-side only (it never calls the network),
 * and plays Node's "receive" once per click; it also plays once when the
 * exhibit scrolls into view. With JavaScript off the nominal drawing renders
 * and the toggle stays hidden. Packets are SMIL that stops by 4.8 s, hidden
 * under reduced motion and paused by src/lib/motion.ts.
 */
import Exhibit from './Exhibit.astro'
import NodeMascot from './NodeMascot.jsx'
import { isNodeReady } from '../../config/node.js'
import { HOME } from '../../data/site/content.js'

const flow = HOME.exhibit
// Node marks the route step once the owner has approved the state; otherwise a plain checkpoint square.
const nodeReady = isNodeReady('holding')
const Y = [40, 118, 196, 274]
const ROUTE = 2
---
<Exhibit
  title={flow.title}
  class="pipeline"
  data-pipeline
  data-state="nominal"
  data-status-nominal={flow.status.nominal}
  data-status-outage={flow.status.outage}
>
  <svg viewBox="0 0 316 304" class="pipeline__svg" role="img" aria-labelledby="pipeline-title" data-motion-root>
    <title id="pipeline-title">An inquiry is taken in, saved first, routed by rules with a webhook branch, then handed to a person.</title>

    <path class="pl-spine" d={`M36 ${Y[0]}V${Y[3]}`} />
    <path class="pl-branch" d={`M60 ${Y[ROUTE]}H218`} />
    <path class="pl-fail" d={`M132 ${Y[ROUTE] - 6}l12 12M144 ${Y[ROUTE] - 6}l-12 12`} />
    <path class="pl-retry-link" d={`M263 ${Y[ROUTE] + 16}V${Y[ROUTE] + 44}`} />

    {flow.checkpoints.map((checkpoint, index) => (
      <g class={`pl-checkpoint pl-checkpoint--${checkpoint.id}`}>
        {(index !== ROUTE || !nodeReady) && <rect class="pl-square" x="29" y={Y[index] - 7} width="14" height="14" rx="2" />}
        <text class="pl-index" x="72" y={index === ROUTE ? Y[index] - 22 : Y[index] - 4}>{checkpoint.index}</text>
        <text class="pl-label" x="72" y={index === ROUTE ? Y[index] - 8 : Y[index] + 12}>{checkpoint.label.toUpperCase()}</text>
      </g>
    ))}
    <text class="pl-note pl-note--persisted" x="72" y={Y[1] + 26}>{flow.heldLabel.toUpperCase()}</text>
    <text class="pl-note pl-note--alerted" x="72" y={Y[3] + 26}>{flow.alertLabel.toUpperCase()}</text>

    <g class="pl-webhook">
      <rect class="pl-box" x="218" y={Y[ROUTE] - 16} width="92" height="32" rx="3" />
      <text class="pl-box-label" x="227" y={Y[ROUTE] + 4}>{flow.branchLabel.toUpperCase()}</text>
      <circle class="pl-led" cx="298" cy={Y[ROUTE]} r="4" />
    </g>
    <g class="pl-retrybox">
      <rect class="pl-box" x="218" y={Y[ROUTE] + 44} width="92" height="32" rx="3" />
      <text class="pl-box-label" x="227" y={Y[ROUTE] + 64}>{flow.retryLabel.toUpperCase()}</text>
    </g>

    <g class="pl-packets">
      <circle class="pl-packet" r="3" cx="36" cy={Y[0]}>
        <animateMotion dur="2.4s" repeatCount="indefinite" end="4.8s" path={`M0 0V${Y[3] - Y[0]}`} />
      </circle>
      <circle class="pl-packet pl-packet--branch" r="3" cx="60" cy={Y[ROUTE]}>
        <animateMotion dur="1.6s" repeatCount="indefinite" end="4.8s" path="M0 0H158" />
      </circle>
    </g>

    {nodeReady && (
      <g transform={`translate(12 ${Y[ROUTE] - 28})`}>
        <NodeMascot state="holding" size={48} id="hero-node" />
      </g>
    )}
  </svg>
  <div slot="controls" class="flex w-full flex-wrap items-center justify-between gap-3">
    <p class="pipeline__status text-step--1 text-dl-ink-2" aria-live="polite" data-pipeline-status>{flow.status.nominal}</p>
    <button type="button" class="pipeline__toggle dl-button-outline" aria-pressed="false" data-pipeline-toggle data-needs-js hidden>{flow.toggleLabel}</button>
  </div>
</Exhibit>

<style>
  .pipeline__svg { display: block; width: 100%; min-width: 300px; height: auto; padding: 0.5rem 0.75rem; }
  .pipeline__status { max-width: 40ch; }
  /* The pressed toggle is visibly on: filled, not only aria-pressed (spec N.5). */
  .pipeline__toggle[aria-pressed='true'] { background: var(--exhibit-paper-2); border-color: var(--amber); }

  .pl-spine,
  .pl-branch,
  .pl-retry-link { fill: none; stroke-width: 2; stroke-linecap: round; }
  .pl-spine { stroke: var(--violet); }
  .pl-branch { stroke: var(--redline); transition: stroke var(--duration-ui) var(--ease-draw); }
  .pl-retry-link { stroke: var(--amber); stroke-dasharray: 3 4; opacity: 0; }
  .pl-fail { fill: none; stroke: var(--danger); stroke-width: 2.5; stroke-linecap: round; opacity: 0; }
  .pl-square { fill: var(--paper-2); stroke: var(--redline); stroke-width: 2; }
  .pl-index,
  .pl-label,
  .pl-note,
  .pl-box-label { font-family: var(--font-label); letter-spacing: 0.08em; }
  .pl-index { font-size: 9px; fill: var(--ink-3); }
  .pl-label { font-size: 10.5px; fill: var(--ink); font-weight: 500; }
  .pl-note { font-size: 9px; fill: var(--amber); opacity: 0; }
  .pl-box { fill: var(--paper-2); stroke: var(--rule); stroke-width: 1.5; }
  .pl-box-label { font-size: 10px; fill: var(--ink-2); }
  .pl-led { fill: var(--ok); }
  .pl-retrybox { opacity: 0; }
  .pl-packet { fill: var(--ink); }

  [data-state='outage'] .pl-branch { stroke: var(--danger); stroke-dasharray: 5 5; }
  [data-state='outage'] .pl-fail,
  [data-state='outage'] .pl-retry-link,
  [data-state='outage'] .pl-retrybox,
  [data-state='outage'] .pl-note { opacity: 1; }
  [data-state='outage'] .pl-retrybox .pl-box { stroke: var(--amber); }
  [data-state='outage'] .pl-webhook .pl-box { stroke: var(--danger); }
  [data-state='outage'] .pl-led { fill: var(--danger); }
  [data-state='outage'] .pl-checkpoint--persist .pl-square { stroke: var(--amber); fill: var(--amber); }
  [data-state='outage'] .pl-packet--branch { display: none; }
  /* In the outage Node waits for a person: the amber lamp (exhibit only). */
  [data-state='outage'] :global(.node-lamp) { fill: var(--amber); }

  .pl-fail,
  .pl-retry-link,
  .pl-retrybox,
  .pl-note { transition: opacity var(--duration-ui) var(--ease-draw); }

  @media (prefers-reduced-motion: reduce) {
    .pl-packets { display: none; }
  }
</style>

<script>
  import { pauseWhenHidden, replayNode, respectReducedMotion } from '../../lib/motion'

  // Client-side only: the outage is a drawing, never a request.
  for (const root of document.querySelectorAll<HTMLElement>('[data-pipeline]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-pipeline-toggle]')
    const status = root.querySelector<HTMLElement>('[data-pipeline-status]')
    if (!button || !status) continue
    button.hidden = false
    // Node's "receive" runs once when the exhibit scrolls into view and once per toggle (spec G.4).
    const node = root.querySelector<SVGSVGElement>('.node-mascot')
    if (node && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        replayNode(node, 'receive')
        observer.disconnect()
      }, { threshold: 0.5 })
      observer.observe(root)
    }
    button.addEventListener('click', () => {
      if (node) replayNode(node, 'receive')
      const outage = root.dataset.state !== 'outage'
      root.dataset.state = outage ? 'outage' : 'nominal'
      button.setAttribute('aria-pressed', String(outage))
      status.textContent = (outage ? root.dataset.statusOutage : root.dataset.statusNominal) ?? ''
    })
  }
  respectReducedMotion()
  pauseWhenHidden()
</script>
