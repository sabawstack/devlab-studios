---
/**
 * §01 Failure modes as a diagnostic console (ADR 0014): WAI-ARIA tabs, one
 * per failure vector. Each panel reads as three rows: the failure vector,
 * the architecture that closes it, and Node's verification line.
 *
 * Keyboard: roving tabindex; Left/Up and Right/Down move between tabs, Home
 * and End jump to the ends, and selection follows focus. The server renders
 * the first panel; the others carry `hidden`. With JS off the tabs are inert,
 * so a <noscript> style shows every panel stacked and hides the tab list.
 */
import { HOME } from '../../data/site/content.js'

const items = HOME.console
const labels = HOME.problems.labels
const index = (position: number) => String(position + 1).padStart(2, '0')
---
<div class="console rounded-dl-m border border-dl-rule bg-dl-paper-2" data-console>
  <div role="tablist" aria-label="Failure vectors" aria-orientation="vertical" class="console__tabs border-b border-dl-rule lg:border-b-0 lg:border-r">
    {items.map((item, position) => (
      <button
        type="button"
        role="tab"
        id={`console-tab-${item.id}`}
        aria-controls={`console-panel-${item.id}`}
        aria-selected={position === 0 ? 'true' : 'false'}
        tabindex={position === 0 ? 0 : -1}
        class="console__tab"
        data-console-tab
      >
        <span class="label text-dl-ink-3">{index(position)}</span>
        <span>{item.title}</span>
      </button>
    ))}
  </div>
  <div class="console__panels">
    {items.map((item, position) => (
      <div
        role="tabpanel"
        id={`console-panel-${item.id}`}
        aria-labelledby={`console-tab-${item.id}`}
        tabindex="0"
        hidden={position !== 0}
        class="console__panel"
        data-console-panel
      >
        <h3 class="label text-dl-ink-3">{index(position)} · {item.title}</h3>
        <dl class="mt-4 divide-y divide-dl-rule border-y border-dl-rule">
          <div class="console__row">
            <dt class="label text-dl-amber">{labels.vector}</dt>
            <dd class="console__value">
              <span>{item.vector}</span>
            </dd>
          </div>
          <div class="console__row">
            <dt class="label text-dl-magenta">{labels.architecture}</dt>
            <dd class="console__value"><span>{item.architecture}</span></dd>
          </div>
          <div class="console__row">
            <dt class="label text-dl-ok">{labels.verification}</dt>
            <dd class="console__value">
              <code class="console__status">{item.verification}</code>
            </dd>
          </div>
        </dl>
      </div>
    ))}
  </div>
</div>
<noscript>
  <style>
    [data-console] [data-console-panel][hidden] { display: block; }
    [data-console] [role='tablist'] { display: none; }
    [data-console] .console__panel + .console__panel { border-top: 1px solid var(--rule); }
  </style>
</noscript>

<style>
  .console { display: grid; overflow: hidden; }
  @media (min-width: 1024px) {
    .console { grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); }
  }
  .console__tabs { display: flex; flex-direction: column; }
  .console__tab {
    display: flex;
    min-height: 56px;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1.25rem;
    border-left: 2px solid transparent;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-display);
    font-size: var(--step-0);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--duration-ui) var(--ease-draw), color var(--duration-ui) var(--ease-draw);
  }
  .console__tab + .console__tab { border-top: 1px solid var(--rule); }
  .console__tab:hover { background: var(--paper); color: var(--ink); }
  .console__tab[aria-selected='true'] { border-left-color: var(--redline); background: var(--paper); color: var(--ink); }
  .console__tab:focus-visible { outline: 2px solid var(--redline); outline-offset: -2px; }
  .console__panel { padding: 1.25rem; }
  @media (min-width: 640px) {
    .console__panel { padding: 1.75rem 2rem; }
  }
  .console__panel:focus-visible { outline: 2px solid var(--redline); outline-offset: -2px; }
  .console__row { display: grid; gap: 0.5rem; padding: 1rem 0; }
  @media (min-width: 640px) {
    .console__row { grid-template-columns: 12rem minmax(0, 1fr); gap: 1.5rem; }
  }
  .console__value { display: flex; align-items: flex-start; gap: 0.75rem; color: var(--ink); }
  .console__status { font-family: var(--font-label); font-size: var(--step--1); color: var(--ok); letter-spacing: 0.02em; }
</style>

<script>
  // Tabs with automatic activation (WAI-ARIA APG tabs pattern).
  for (const root of document.querySelectorAll<HTMLElement>('[data-console]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-console-tab]')]
    const select = (next: HTMLButtonElement, focus: boolean) => {
      for (const tab of tabs) {
        const selected = tab === next
        tab.setAttribute('aria-selected', String(selected))
        tab.tabIndex = selected ? 0 : -1
        const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`)
        if (panel) panel.hidden = !selected
      }
      if (focus) next.focus()
    }
    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab, false))
      tab.addEventListener('keydown', (event) => {
        const current = tabs.indexOf(tab)
        const last = tabs.length - 1
        const target = {
          ArrowDown: current === last ? 0 : current + 1,
          ArrowRight: current === last ? 0 : current + 1,
          ArrowUp: current === 0 ? last : current - 1,
          ArrowLeft: current === 0 ? last : current - 1,
          Home: 0,
          End: last,
        }[event.key]
        if (target === undefined) return
        event.preventDefault()
        select(tabs[target], true)
      })
    }
  }
</script>
