---
/**
 * The principal engineer beside the audit card (ADR 0014): the portrait, the
 * single-architect contrast (the founder's one mention on the home page) and
 * a link to the profile.
 */
import Portrait from './Portrait.astro'
import { COMPANY } from '../../config/company.js'
import { HOME } from '../../data/site/content.js'

const copy = HOME.principal
---
<aside class="flex flex-col gap-5 rounded-dl-m border border-dl-rule bg-dl-paper-2 p-6 sm:flex-row sm:p-8" aria-labelledby="principal-heading" data-principal>
  <Portrait size={96} class="shrink-0" />
  <div>
    <h3 id="principal-heading" class="label text-dl-magenta">{copy.eyebrow}</h3>
    <p class="mt-3 text-dl-ink-2">{copy.text}</p>
    <a href={COMPANY.founder.profilePath} class="dl-button-quiet mt-2" data-cta-id="home-principal-profile">{copy.linkLabel}</a>
  </div>
</aside>
