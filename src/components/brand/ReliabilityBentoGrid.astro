---
/**
 * §02 Rules of reliability (ADR 0014): four rules in an asymmetric grid. Two
 * columns from 768 px; from 1024 px the first rule fills a wider left column
 * and the other three stack beside it. Each
 * card's border turns to the brand gradient on hover or keyboard focus within.
 */
import { HOME } from '../../data/site/content.js'

const rules = HOME.bento
const log = HOME.persistLog
---
<ol class="bento mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr]">
  {rules.map((rule, position) => (
    <li class={`dl-gradient-border flex flex-col p-6 sm:p-8 ${position === 0 ? 'lg:justify-between' : ''}`} data-rule-id={rule.id}>
      <p class="label text-dl-magenta">{String(position + 1).padStart(2, '0')}</p>
      {position === 0 && (
        <ol class="bento__log mt-6 rounded-dl-s border border-dl-rule bg-dl-paper p-4" aria-label="Delivery log">
          {log.map((line, row) => (
            <li class="flex gap-3">
              <span class="text-dl-ink-3">{String(row + 1).padStart(2, '0')}</span>
              <span class="w-16 shrink-0 uppercase text-dl-ink-2">{line.step}</span>
              <span class="flex-1 text-dl-ink">{line.target}</span>
              <span class={line.result === 'ok' ? 'text-dl-ok' : 'text-dl-amber'}>{line.result.toUpperCase()}</span>
            </li>
          ))}
        </ol>
      )}
      <div class={position === 0 ? 'mt-6 lg:mt-auto' : 'mt-4'}>
        <h3 class={position === 0 ? 'text-step-3' : 'text-step-1'}>{rule.title}</h3>
        <p class="mt-3 text-dl-ink-2">{rule.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  /* The middle two rules sit in the right column, the fourth spans its foot. */
  .bento__log { font-family: var(--font-label); font-size: var(--step--1); line-height: 2; }
  @media (min-width: 1024px) {
    .bento { grid-template-rows: auto auto auto; }
    .bento > li:first-child { grid-row: 1 / span 3; }
  }
</style>
