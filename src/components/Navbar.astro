---
import PrimaryButton from './PrimaryButton.jsx'
import AnimatedIcon from './icons/AnimatedIcon.jsx'
import { Mail, Menu, X } from './icons/icons.js'
import devlabStudiosLogo from '../assets/devlabstudios-logo-only.png'
import { brandingAssets } from '../config/branding.js'
import type { SiteSettingsData } from '../lib/content/siteSettings'

interface Props {
  siteSettings: SiteSettingsData
  currentPath: string
}

const { siteSettings, currentPath } = Astro.props
const navLinks = (siteSettings.navigation || []).map((item) => ({ label: item.label, href: item.href }))
const desktopContactLabel = siteSettings.ctas?.navbarContactLabel || 'Discuss Your System'
const mobileContactLabel = siteSettings.ctas?.mobileContactLabel || desktopContactLabel
const linkBase = 'site-navbar__link rounded-full px-3 py-2 text-sm font-semibold transition focus-visible:outline-none'
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-40 pt-[env(safe-area-inset-top,0px)] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]">
  <div class="w-full px-4 mx-auto max-w-7xl sm:px-6 lg:px-6">
    <div class="site-navbar mt-3 flex items-center justify-between px-1 py-3 sm:px-2">
      <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-white">
        <img
          id="navbar-logo"
          src={brandingAssets.logoOnlyUrl}
          data-fallback-src={devlabStudiosLogo.src}
          alt="DevLab Studios"
          class="h-11 w-11 rounded-md object-contain"
          loading="eager"
          width="44"
          height="44"
        />
        <span class="text-[#f8fbff]">DevLab Studios</span>
      </a>

      <nav class="site-navbar__links hidden items-center gap-1 rounded-full px-2 py-1 md:flex">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class={`${linkBase} ${currentPath === item.href ? 'site-navbar__link--active' : ''}`}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="hidden md:block">
        <div class="group">
          <PrimaryButton
            to="/contact?type=business_system"
            className="flex items-center gap-2 px-4 py-2"
            data-cta-id="navbar-contact"
            data-cta-variant="primary"
            data-inquiry-type="business_system"
          >
            <AnimatedIcon icon={Mail} size={18} animationType="hover-scale" />
            {desktopContactLabel}
          </PrimaryButton>
        </div>
      </div>

      <button
        type="button"
        id="mobile-nav-toggle"
        class="group inline-flex h-11 w-11 items-center justify-center rounded-lg border border-brand-orange bg-brand-orange text-white shadow-sm transition hover:bg-brand-orangeDark hover:border-brand-orangeDark focus-visible:ring-2 focus-visible:ring-brand-orange focus-visible:ring-offset-2 md:hidden"
        aria-label="Open navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="sr-only">Toggle navigation</span>
        <span id="mobile-nav-icon-open"><AnimatedIcon icon={Menu} size={24} animationType="none" /></span>
        <span id="mobile-nav-icon-close" class="hidden"><AnimatedIcon icon={X} size={24} animationType="none" /></span>
      </button>
    </div>

    <div id="mobile-navigation" class="mt-2 hidden rounded-2xl border border-white/10 bg-[#080d21]/95 p-3 text-white shadow-[0_18px_44px_rgba(4,8,24,0.28)] md:hidden">
      <nav class="flex flex-col gap-1">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class={`block rounded-xl px-3 py-3 text-sm font-semibold transition ${currentPath === item.href ? 'bg-white/10 text-white' : 'text-slate-300 hover:bg-white/[0.06]'}`}
          >
            {item.label}
          </a>
        ))}
        <PrimaryButton
          to="/contact?type=business_system"
          className="flex items-center justify-center w-full gap-2"
          data-cta-id="navbar-contact-mobile"
          data-cta-variant="primary"
          data-inquiry-type="business_system"
        >
          <AnimatedIcon icon={Mail} size={16} animationType="none" />
          {mobileContactLabel}
        </PrimaryButton>
      </nav>
    </div>
  </div>
</header>

<script>
  const logo = document.getElementById('navbar-logo') as HTMLImageElement | null
  const useFallbackLogo = () => {
    if (logo?.dataset.fallbackSrc && logo.src !== new URL(logo.dataset.fallbackSrc, location.href).href) {
      logo.src = logo.dataset.fallbackSrc
    }
  }
  logo?.addEventListener('error', useFallbackLogo, { once: true })
  // This script runs after the image may already have failed — e.g. a network
  // whose DNS does not resolve *.r2.dev fails instantly — and an `error` event
  // that fired before the listener existed is never replayed.
  if (logo?.complete && logo.naturalWidth === 0) useFallbackLogo()

  const toggle = document.getElementById('mobile-nav-toggle')
  const panel = document.getElementById('mobile-navigation')
  const header = document.getElementById('site-header')
  const iconOpen = document.getElementById('mobile-nav-icon-open')
  const iconClose = document.getElementById('mobile-nav-icon-close')

  const syncHeaderSurface = () => header?.classList.toggle('site-header--scrolled', window.scrollY > 24)
  syncHeaderSurface()
  window.addEventListener('scroll', syncHeaderSurface, { passive: true })

  const setOpen = (isOpen: boolean) => {
    panel?.classList.toggle('hidden', !isOpen)
    toggle?.setAttribute('aria-expanded', String(isOpen))
    toggle?.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation')
    iconOpen?.classList.toggle('hidden', isOpen)
    iconClose?.classList.toggle('hidden', !isOpen)
  }

  toggle?.addEventListener('click', () => {
    setOpen(panel?.classList.contains('hidden') === true)
  })

  // Escape closes the panel and returns focus to the control that opened it —
  // without this a keyboard user who opens the menu has no way back out.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || panel?.classList.contains('hidden') !== false) return
    setOpen(false)
    toggle?.focus()
  })
</script>
