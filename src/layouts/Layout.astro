---
import '../index.css'
import '../styles/brand.css'
import SeoHead from '../components/SeoHead.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import PublicBackdrop from '../components/PublicBackdrop.astro'
import { loadSiteSettings } from '../lib/content/siteSettings'
import type { SeoData } from '../lib/content/seo'

interface Props {
  title: string
  seo?: SeoData | null
  jsonLd?: Record<string, unknown> | null | (Record<string, unknown> | null)[]
}

const { title, seo = null, jsonLd } = Astro.props
const siteSettings = await loadSiteSettings()
const currentPath = new URL(Astro.request.url).pathname
// Helpers like getFaqSchema() return null when there is nothing truthful to
// emit, so falsy entries are dropped rather than rendered as a `null` script.
const jsonLdBlocks = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []).filter(Boolean)

/**
 * JSON.stringify doesn't escape `<`, so a string value containing
 * `</script>` would prematurely close this tag and let arbitrary HTML/JS
 * that follows execute. Not exploitable today (only static strings feed
 * this), but every jsonLd caller should be safe by default rather than
 * relying on each one remembering to sanitize its own inputs.
 */
function safeJsonLd(value: unknown): string {
  return JSON.stringify(value).replace(/</g, '\\u003c')
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#070916" />
    <meta name="robots" content="index, follow" />
    <SeoHead fallbackTitle={title} seo={seo} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={safeJsonLd(block)} />
    ))}

    <!-- Font preconnect + async load (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" /></noscript>
    <link rel="icon" type="image/png" href="/devlabstudios-logo-only.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google tag (gtag.js), delayed so it does not compete with first render on mobile. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.addEventListener('load', function () {
        var loadAnalytics = function () {
          var script = document.createElement('script');
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-MD3PL91M9G';
          script.async = true;
          document.head.appendChild(script);
          gtag('js', new Date());
          gtag('config', 'G-MD3PL91M9G', { client_storage: 'none', anonymize_ip: true });
        };

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadAnalytics, { timeout: 3000 });
        } else {
          window.setTimeout(loadAnalytics, 1800);
        }
      });
    </script>
  </head>
  <body class="public-page">
    <div class="public-shell relative flex min-h-screen flex-col">
      <PublicBackdrop />
      <Navbar siteSettings={siteSettings} currentPath={currentPath} />

      <div class="relative z-10 flex flex-1 flex-col pt-[calc(6.75rem+env(safe-area-inset-top,0px))]">
        <main class="public-main mx-auto w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-6">
          <slot />
        </main>
        <Footer siteSettings={siteSettings} />
      </div>
    </div>

    <script>
      import { initScrollReveal } from '../lib/scrollReveal'
      import { initAnalytics, initViewTracking } from '../lib/analyticsBootstrap'

      initScrollReveal()
      // Attribution and the delegated CTA listener are set up immediately (they
      // are a few hundred bytes and must not miss an early click); the GA4
      // script itself is still deferred to idle by the inline tag in <head>,
      // and track() is a no-op until it lands.
      initAnalytics()
      initViewTracking()
    </script>

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </body>
</html>
