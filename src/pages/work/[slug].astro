---
/**
 * A Work write-up in the case-study order of spec K.2 (CASE-01): the
 * situation (when written), the problem, what we built with the project's own
 * diagram and the decisions that mattered, what it does now (outcomes only
 * with evidence, else a "not published" line), real screenshots on mounts,
 * scope and responsibility, Technical notes, and one call to action. Entries come from the CMS Work page and
 * projects (loadWorkEntries). A published row in the older case_studies table
 * is still served at its slug so no existing link breaks; anything else 404s.
 */
import BrandLayout from '../../layouts/BrandLayout.astro'
import PageHeader from '../../components/brand/PageHeader.astro'
import Section from '../../components/brand/Section.astro'
import SceneFrame from '../../components/brand/SceneFrame.astro'
import ProofMount from '../../components/brand/ProofMount.astro'
import FactList from '../../components/brand/FactList.astro'
import Disclosure from '../../components/brand/Disclosure.astro'
import Tag from '../../components/brand/Tag.astro'
import { createFigureCounter } from '../../components/brand/figures'
import { getBreadcrumbSchema, getCreativeWorkSchema } from '../../config/schema.js'
import { SERVICE_LINES } from '../../data/site/content.js'
import { loadWorkEntries } from '../../lib/content/work'
import { loadCaseStudy } from '../../lib/content/caseStudies'
import type { SeoData } from '../../lib/content/seo'
import type { OptimizedPicture } from '../../lib/images/optimizeImage'
import { COMPANY } from '../../config/company.js'
import { CTA } from '../../config/ctas.js'

const { slug } = Astro.params as { slug: string }
const entries = await loadWorkEntries()
const entry = entries.find((candidate) => candidate.slug === slug) || null
const caseStudy = entry ? null : await loadCaseStudy(slug)

if (!entry && !caseStudy) {
  return Astro.rewrite('/404')
}

const title = entry ? entry.project.title : caseStudy!.title
const summary = entry ? entry.summary : caseStudy!.summary
const path = `/work/${slug}`
const seo: SeoData = {
  metaTitle: `${title.length > 44 ? `${title.slice(0, 43).trimEnd()}…` : title} · DevLab Work`,
  metaDescription: summary.length > 160 ? `${summary.slice(0, 157).trimEnd()}…` : summary,
  canonicalUrl: `https://www.devlabstudios.com${path}`,
  ogTitle: title,
  ogDescription: summary.slice(0, 200),
  ogImage: 'https://www.devlabstudios.com/og/work.png',
  twitterImage: 'https://www.devlabstudios.com/og/work.png',
}
const breadcrumbs = getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work' }, { name: title, path }])
const line = entry ? SERVICE_LINES.find((candidate) => candidate.workProjectId === entry.project.id) : null
const coverSrc = entry?.project.optimizedImageFull?.src
const jsonLd = entry
  ? [breadcrumbs, getCreativeWorkSchema({
      slug,
      title,
      summary,
      image: coverSrc ? new URL(coverSrc, Astro.url).toString() : undefined,
      about: line?.title,
      inOperationSince: entry.inOperationSince || undefined,
    })]
  : [breadcrumbs]
const figures = createFigureCounter()
type Shot = { picture: NonNullable<OptimizedPicture>; caption: string }
// The gallery when there is one (the cover is usually its first image), else the cover.
const gallery: Shot[] = entry
  ? (entry.project.galleryImages || []).flatMap((image, index) =>
      image.optimized ? [{ picture: image.optimized, caption: String(image.caption || image.alt || `${title}: screenshot ${index + 1}.`) }] : [])
  : []
const shots: Shot[] = (gallery.length
  ? gallery
  : entry?.project.optimizedImageFull ? [{ picture: entry.project.optimizedImageFull, caption: `${title}: the workflow as built (screenshot).` }] : []
).slice(0, 3)
// CONTENT-05: the short lead is the summary; the project's longer architecture description moves here.
const technicalSummary = entry && entry.project.description && entry.project.description !== summary ? String(entry.project.description) : ''
/** K.2: results are shown only with evidence and consent; scope is stated or explicitly not published. */
const RESULTS_NOT_PUBLISHED = "Operational results are the client's and are not published."
const SCOPE_NOT_PUBLISHED = 'Scope and responsibility were agreed with the client for this engagement and are not published.'
const formatSince = (value: string) => {
  const [year, month] = value.split('-').map(Number)
  return month ? new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString('en', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : String(year)
}
const contactHref = `/contact?type=business_system&case=${encodeURIComponent(entry ? entry.project.id : slug)}`
const caseSections = caseStudy
  ? [
      { title: 'Problem', body: caseStudy.problem },
      { title: 'Constraints', body: caseStudy.constraints },
      { title: 'Architecture', body: caseStudy.architecture },
      { title: 'Implementation', body: caseStudy.implementation },
      { title: 'Outcomes', body: caseStudy.outcomes },
    ].filter((section) => section.body)
  : []
---

<BrandLayout title={seo.metaTitle || 'DevLab Studios'} seo={seo} jsonLd={jsonLd}>
  <PageHeader breadcrumb={[{ label: 'Work', href: '/work' }]} eyebrow={entry ? 'Write-up' : 'Case study'} heading={title} lead={summary}>
    <a href={contactHref} class="dl-button-primary" data-cta-id="work-detail-primary" data-case-study-id={entry ? entry.project.id : slug} data-inquiry-type="business_system">{CTA.similar}</a>
    <a href="/work" class="dl-button-quiet" data-cta-id="work-detail-back">Back to work</a>
  </PageHeader>

  {entry ? (
    <>
      {entry.situation && (
        <Section id="work-situation" eyebrow="The situation" heading="Who it was for">
          <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2">{entry.situation}</p>
        </Section>
      )}

      <Section id="work-problem" eyebrow="The problem" heading="What was going wrong" class={entry.situation ? 'border-t border-dl-rule' : ''}>
        <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2">{entry.problem}</p>
      </Section>

      <Section id="work-system" eyebrow="What we built" heading="The system" class="border-t border-dl-rule">
        {entry.sceneId && <SceneFrame sceneId={entry.sceneId} figure={figures.next()} class="mt-8" />}
        <p class="mt-8 max-w-prose text-step-1 text-dl-ink-2">{entry.system}</p>
        {entry.decisions.length > 0 && (
          <>
            <h3 class="mt-10 text-step-1">Decisions that mattered</h3>
            <ul class="mt-4 max-w-prose divide-y divide-dl-rule border-y border-dl-rule" data-decisions>
              {entry.decisions.map((decision) => <li class="py-3 text-dl-ink-2">{decision}</li>)}
            </ul>
          </>
        )}
      </Section>

      <Section id="work-result" eyebrow="What it does now" heading="What it verifiably does" class="border-t border-dl-rule">
        <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2">{entry.value}</p>
        {entry.outcomes.length > 0
          ? <FactList facts={entry.outcomes.map((text) => ({ text }))} class="mt-8" />
          : <p class="mt-6 text-dl-ink-3" data-results-note>{RESULTS_NOT_PUBLISHED}</p>}
        {entry.inOperationSince && <p class="mt-4 text-dl-ink-3" data-in-operation>In operation since {formatSince(entry.inOperationSince)}.</p>}
        {shots.map((shot) => (
          <ProofMount picture={shot.picture} caption={shot.caption} number={figures.next()} looking="A real screenshot, with client data removed or replaced with synthetic data." class="mt-10" />
        ))}
        {entry.evidenceNote && <p class="mt-6 text-step--1 text-dl-ink-3">{entry.evidenceNote}</p>}
      </Section>

      <Section id="work-scope" eyebrow="Scope and responsibility" heading="Who built and runs what" class="border-t border-dl-rule">
        <p class="mt-4 max-w-prose text-dl-ink-2" data-scope>{entry.scope || SCOPE_NOT_PUBLISHED}</p>
        <p class="mt-6 text-step--1 text-dl-ink-2" data-founder-line>
          Designed and built by Stephen Rey Agustinez, founder of {COMPANY.name}. <a href={COMPANY.founder.profilePath} data-cta-id="work-detail-profile">Founder profile</a>
        </p>
        {((entry.project.techStack || []).length > 0 || technicalSummary) && (
          <Disclosure summary="Technical notes" class="mt-10">
            {technicalSummary && <p class="mb-4 max-w-prose text-dl-ink-2" data-technical-summary>{technicalSummary}</p>}
            <ul class="flex flex-wrap gap-2" aria-label="Tools and services used">
              {(entry.project.techStack || []).map((tool) => <li><Tag>{tool}</Tag></li>)}
            </ul>
          </Disclosure>
        )}
      </Section>
    </>
  ) : (
    caseSections.map((section, index) => (
      <Section id={`case-${index}`} eyebrow={section.title} heading={section.title} class={index ? 'border-t border-dl-rule' : ''}>
        <p class="mt-4 text-step-1 text-dl-ink-2">{section.body}</p>
      </Section>
    ))
  )}

  <section aria-labelledby="work-cta-heading" class="dl-band">
    <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)]">
      <h2 id="work-cta-heading" class="max-w-3xl text-step-3">Need something like this?</h2>
      <p class="mt-4 text-step-1 text-dl-ink-2">Describe the workflow in your own words.</p>
      <a href={contactHref} class="dl-button-primary mt-8" data-cta-id="work-detail-final" data-inquiry-type="business_system">{CTA.similar}</a>
    </div>
  </section>
</BrandLayout>
