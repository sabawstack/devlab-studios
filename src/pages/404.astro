---
/** Not found (brand layout). Always 404 and noindex; offers the main routes. */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import { ERROR_MESSAGES } from '../config/errorMessages.js'

Astro.response.status = 404
const { title, message } = ERROR_MESSAGES.NOT_FOUND
const routes = [
  { href: '/solutions', label: 'Solutions', text: 'What we build' },
  { href: '/work', label: 'Work', text: 'Systems already running' },
  { href: '/insights', label: 'Insights', text: 'Notes on operations problems' },
  { href: '/contact', label: 'Contact', text: 'Tell us what you need' },
]
---

<BrandLayout title={`${title} · DevLab Studios`} robots="noindex, follow">
  <PageHeader eyebrow="404" heading={title} lead={message}>
    <a href="/" class="dl-button-primary">Go to the home page</a>
  </PageHeader>
  <nav aria-label="Main sections" class="mx-auto max-w-container px-[var(--gutter)] py-12">
    <ul class="grid gap-px overflow-hidden rounded-dl-s border border-dl-rule bg-dl-rule sm:grid-cols-2 lg:grid-cols-4">
      {routes.map((route) => (
        <li class="bg-dl-paper"><a href={route.href} class="block p-6 no-underline hover:bg-dl-paper-2"><span class="label text-dl-ink-3">{route.label}</span><span class="mt-2 block text-dl-ink">{route.text}</span></a></li>
      ))}
    </ul>
  </nav>
</BrandLayout>
