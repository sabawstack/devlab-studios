---
import LegalPage from '../components/brand/LegalPage.astro'
import { draftPreviewFor } from '../lib/content/preview'
import { loadPage } from '../lib/content/pages'
import { loadPageSeo } from '../lib/content/seo'

const seo = await loadPageSeo('terms')
const page = await loadPage('terms', { includeDrafts: await draftPreviewFor(Astro, { type: 'page', id: 'terms' }) })
---

<LegalPage page={page} fallbackTitle="Terms of Service" seo={seo} />
