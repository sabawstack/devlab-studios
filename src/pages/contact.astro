---
/**
 * Contact (audit UX-11 / LEAD-03 / BR.9): describe the problem, a person reads
 * it. The two-step InquiryForm island is unchanged in behaviour; `.dl-form`
 * gives it the brand tokens. CTA context arrives as query parameters so a
 * visitor never classifies themselves twice. Product types (from /products)
 * are accepted here and locked, because the select does not offer them.
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import InquiryForm from '../components/islands/InquiryForm.jsx'
import { getBreadcrumbSchema } from '../config/schema.js'
import { loadPageSeo } from '../lib/content/seo'
import { resolveTurnstileSiteKey } from '../lib/turnstileSiteKey'
import { CONTACT_FORM_INQUIRY_TYPES, PRODUCT_INQUIRY_TYPES, isEmploymentInquiry, isProductInquiry, type InquiryType } from '../lib/schemas/inquiry'
import { CONTACT_PAGE } from '../data/site/content.js'
import SceneFrame from '../components/brand/SceneFrame.astro'
import { businessHoursLine, replyWindowLine } from '../config/business.js'
import { publicContactEmail } from '../config/company.js'
import { loadSiteSettings } from '../lib/content/siteSettings'

const seo = await loadPageSeo('contact')
const siteSettings = await loadSiteSettings()
const { business } = siteSettings
const email = publicContactEmail(siteSettings.footer?.email)
/** Q-05: email and the form only; a channel appears once its link is set in Site Settings. */
const channels = [
  { label: 'Book a call', href: business.schedulingUrl },
  { label: 'Messenger', href: business.messengerUrl },
  { label: 'WhatsApp', href: business.whatsappUrl },
].filter((channel) => channel.href)
const turnstileSiteKey = resolveTurnstileSiteKey(Astro.request.url)

const requestedType = Astro.url.searchParams.get('type') || ''
const accepted: readonly string[] = [...CONTACT_FORM_INQUIRY_TYPES, ...PRODUCT_INQUIRY_TYPES]
const inquiryType = (accepted.includes(requestedType) ? requestedType : 'business_system') as InquiryType
const solutionId = (Astro.url.searchParams.get('solution') || '').slice(0, 80)
const caseStudyId = (Astro.url.searchParams.get('case') || '').slice(0, 80)
const insightId = (Astro.url.searchParams.get('insight') || '').slice(0, 80)
const isEmployment = isEmploymentInquiry(inquiryType)
const isProduct = isProductInquiry(inquiryType)

const heading = isEmployment ? 'Talk to Stephen about a role.' : isProduct ? 'Tell us what you would use it for.' : CONTACT_PAGE.heading
const lead = isEmployment
  ? 'This goes directly to Stephen, not through the business questions. Share the role and what you are looking for.'
  : isProduct
    ? 'Interest is not a commitment. A person reads it, and we talk before anything is built.'
    : CONTACT_PAGE.lead

const jsonLd = [getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]
---

<BrandLayout title={isEmployment ? 'Contact Stephen · DevLab Studios' : 'Contact · DevLab Studios'} seo={seo} jsonLd={jsonLd}>
  <PageHeader eyebrow={isEmployment ? 'Employment and collaboration' : CONTACT_PAGE.eyebrow} heading={heading} lead={lead} />

  <div class="mx-auto grid max-w-container gap-10 px-[var(--gutter)] py-12 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-start">
    <div class="dl-form">
      <InquiryForm
        client:load
        siteKey={turnstileSiteKey}
        formId={isEmployment ? 'employment-inquiry-form' : isProduct ? 'product-inquiry-form' : 'business-inquiry-form'}
        defaultInquiryType={inquiryType}
        lockInquiryType={isProduct}
        context={{ solutionId, caseStudyId, insightId }}
        heading={isEmployment ? 'About the role' : 'Tell us about the system you need'}
        description={isEmployment ? 'The more specific the role and the stack, the more useful the reply.' : 'Two short steps. The second one shapes the recommendation.'}
      />
    </div>

    <aside class="grid gap-6">
      {!isEmployment && <SceneFrame sceneId="the-receipt" caption="What happens after you send it: saved and stamped first, a receipt to you, then a person." />}
      <p class="border-l-2 border-dl-ink pl-4 text-dl-ink-2" data-persistence-statement>{CONTACT_PAGE.persistence}</p>
      {!isEmployment && (
        <p class="text-dl-ink-2" data-reply-window>
          You get an automatic receipt as soon as your inquiry is saved. The reply comes from a person {replyWindowLine(business)}. Hours: {businessHoursLine(business)}.
        </p>
      )}
      <p class="text-dl-ink-2" data-contact-alternatives>
        Prefer email? Write to <a href={`mailto:${email}`} data-cta-id="contact-email">{email}</a>.
        {channels.map((channel) => <> <a href={channel.href} rel="noopener" data-cta-id={`contact-${channel.label.toLowerCase().replace(/\s+/g, '-')}`}>{channel.label}</a></>)}
      </p>
      {isEmployment ? (
        <p class="text-dl-ink-2">
          Need a system built rather than a person hired?{' '}
          <a href="/contact?type=business_system" data-cta-id="contact-business-switch" data-inquiry-type="business_system">Talk to us about a business system</a>.
        </p>
      ) : (
        <p class="text-dl-ink-2">
          Hiring, not buying?{' '}
          <a href="/contact?type=employment_opportunity" data-cta-id="contact-employment-switch" data-inquiry-type="employment_opportunity">Contact Stephen about a role</a>.
        </p>
      )}
    </aside>
  </div>
</BrandLayout>
