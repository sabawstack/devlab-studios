---
import { CTA } from '../config/ctas.js'
/**
 * About (audit UX-10 / BR.9): who we are, where we are, what we hold to and
 * how a project runs. /process redirects to #how-we-work here.
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import Section from '../components/brand/Section.astro'
import SceneFrame from '../components/brand/SceneFrame.astro'
import Portrait from '../components/brand/Portrait.astro'
import { createFigureCounter } from '../components/brand/figures'
import { getBreadcrumbSchema, getOrganizationSchema } from '../config/schema.js'
import { COMPANY } from '../config/company.js'
import { loadPageSeo } from '../lib/content/seo'
import { ABOUT, DELIVERY_STEPS, RELIABILITY_PRINCIPLES } from '../data/site/content.js'

const seo = await loadPageSeo('about')
const figures = createFigureCounter()
const jsonLd = [getOrganizationSchema(), getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }])]
---

<BrandLayout title="About · DevLab Studios" seo={seo} jsonLd={jsonLd}>
  <PageHeader eyebrow={ABOUT.eyebrow} heading={ABOUT.heading} lead={ABOUT.lead}>
    <a href="/contact?type=business_system" class="dl-button-primary" data-cta-id="about-hero-primary" data-inquiry-type="business_system">{CTA.primary}</a>
    <a href={COMPANY.founder.profilePath} class="dl-button-quiet" data-cta-id="about-hero-profile">Founder profile</a>
    <div slot="aside" class="flex flex-col gap-6">
      <Portrait size={160} loading="eager" />
      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 border-t border-dl-rule pt-6">
        {ABOUT.facts.map((fact) => (
          <div>
            <dt class="label text-dl-ink-3">{fact.label}</dt>
            <dd class="mt-1">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </PageHeader>

  <Section id="about-principles" eyebrow="Principles" heading={ABOUT.principlesHeading}>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start">
      <ol class="divide-y divide-dl-rule border-y border-dl-rule">
        {RELIABILITY_PRINCIPLES.map((principle, index) => (
          <li class="flex gap-4 py-4">
            <span class="label shrink-0 pt-1 text-dl-ink-3">{String(index + 1).padStart(2, '0')}</span>
            <span><strong class="block font-semibold">{principle.title}</strong><span class="text-dl-ink-2">{principle.text}</span></span>
          </li>
        ))}
      </ol>
      <SceneFrame sceneId="build-in-layers" figure={figures.next()} />
    </div>
  </Section>

  <Section id="how-we-work" eyebrow="Delivery" heading={ABOUT.howHeading} class="scroll-mt-24 border-t border-dl-rule">
    <ol class="mt-10 grid gap-px overflow-hidden rounded-dl-s border border-dl-rule bg-dl-rule sm:grid-cols-2 lg:grid-cols-4">
      {DELIVERY_STEPS.map((step, index) => (
        <li class="bg-dl-paper p-6">
          <p class="label text-dl-ink-3">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-step-1">{step.title}</h3>
          <p class="mt-2 text-dl-ink-2">{step.text}</p>
        </li>
      ))}
    </ol>
    <p class="mt-8 text-dl-ink-2">
      We also build and run our own products. <a href="/products" data-cta-id="about-products">See what is live</a>.
    </p>
  </Section>

  <section id="about-cta" aria-labelledby="about-cta-heading" class="dl-band">
    <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)]">
      <h2 id="about-cta-heading" class="max-w-3xl text-step-3">Tell us about the system you need.</h2>
      <a href="/contact?type=business_system" class="dl-button-primary mt-8" data-cta-id="about-final-primary" data-inquiry-type="business_system">{CTA.primary}</a>
    </div>
  </section>
</BrandLayout>
