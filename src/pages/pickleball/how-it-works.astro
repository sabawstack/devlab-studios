---
import Layout from '../../layouts/Layout.astro'
import BracketArt from '../../components/pickleball/art/BracketArt.jsx'
import ScoreTapArt from '../../components/pickleball/art/ScoreTapArt.jsx'
import { loadPageSeo } from '../../lib/content/seo'
import '../../styles/pickleball-open.css'

// The host guide. Every step describes shipped behaviour only (spec
// §11 copy rule, pinned by pickleball-public-pages.spec.js). Explicit hex
// colours for the same reason as the landing page: the public shell is dark.
const seo = await loadPageSeo('pickleball-how-it-works')

const steps = [
  { title: 'Start a session', body: 'Open "Start a free session", name it, choose how many courts, what games go to (11, 15 or 21) and how players are matched. No account needed. A short welcome message for players is filled in for you: change it, or clear it, now or any time from the console.' },
  { title: 'Choose who plays whom', body: 'Paddle stack puts whoever has played least on next. Winners play winners sends winners against winners and losers against losers, with last game’s partners split up. By standing matches players close in today’s standings. Balanced teams evens out skill. Switch any time from the console; the switch applies to the next game. Whichever you pick, anyone who has sat out 2 rounds in a row goes on next, unless a keep-together or keep-apart rule holds them back.' },
  { title: 'Add players', body: 'Paste your list or upload a CSV. Numbering, emoji and duplicates are removed. Or show the check-in QR from Share: players type their own name, and a skill if they like, and join level with whoever has played least. Turn check-in off any time.' },
  { title: 'Save your host link, share the board', body: 'Your host link controls the session; keep it. Show players the QR code for the view-only board. If you link the session to Google for a DUPR export, My sessions reopens it as host on any device.' },
  { title: 'Put the board on a TV', body: 'Open the TV board from Share on a venue screen. Every court, who is up next, the standings and the fairness numbers, in type big enough to read across the hall, with the check-in code in the corner.' },
  { title: 'Start the proposed game', body: 'Each free court shows the next four players. Tap Start, or tap Edit to swap anyone first. Players never belong to a court: whichever court frees first gets the next match.' },
  { title: 'Tap the result', body: 'When a game ends, tap Game over, pick the winner and the losing score. The winning score fills in, and the court gets its next match.' },
  { title: 'Hand a court to a captain', body: 'From More, make a captain link for a court and send it to a helper. On their own phone they can start that court’s games and save, undo or fix its results, nothing else. Turn the link off and it stops working at once.' },
  { title: 'Late arrivals and breaks', body: 'Add players any time; they start level with whoever has played least. Put someone on a break and they are skipped until you bring them back.' },
  { title: 'Keep friends together, or apart', body: 'On the Players tab, set two players to always partner, or never share a court. Every way of matching keeps it; if no game fits, the court waits and says why. The fairness panel shows the games spread, the longest wait and repeat partners as you go.' },
  { title: 'Or run a tournament', body: 'Pick Tournament when you start. Choose round robin, pools then a bracket (the top 2 of each pool go through), single elimination or double elimination. Pairs are made at random, balanced by skill (strongest with weakest) or in list order, and seeded at random, by skill or in your own order.' },
  { title: 'Edit the draw, then start', body: 'Generate the draw and change anything: swap players between pairs, swap two pairs, move a pair to another pool, or change who plays whom. A change that would break the draw is refused with the reason. Start locks it; after that you can substitute a player in a pair that is off court, or swap opponents between games in the same round that have not started, where the draw placed both pairs, such as first-round games. A pair that got there by a result moves only when you change that result.' },
  { title: 'Courts fill from the draw', body: 'Whichever court frees next is offered the next game the draw allows, and you tap Start. The board on every phone shows the pools, the bracket and the pair standings; the TV shows the standings, recent results and the next games. Later rounds fill in as results are saved, and the winners get a moment in the spotlight.' },
  { title: 'Fix a mistake', body: 'Undo a save for 2 minutes, or edit a result later. Standings update straight away. In a tournament, a result cannot change once the game it feeds has started; change that game first.' },
  { title: 'Send games to DUPR', body: 'From More, choose Email me the DUPR export. This is the only step that asks anyone to sign in with Google, and only you, the host, can take it. Link the session to your Google account (once per session), enter your DUPR Club ID (once, for every session) and add any missing DUPR IDs. Every game with a valid score (no tie, a team reached 6) and four different DUPR IDs goes into a CSV emailed to your Google address, with each game left out and why. Upload it in DUPR under Matches → Add Matches → Import Matches via CSV; your DUPR account must be a Club Director or Organizer of the club. Up to 5 exports per session a day. Delete your account any time from the same screen.' },
  { title: 'Finish up', body: 'End the session and download the results as a CSV. Everything is deleted 7 days after the last change, or delete it yourself any time.' },
]
---
<Layout title="How to run open play with Devlab Pickleball" seo={seo}>
  <div class="mx-auto max-w-4xl px-4 py-10 md:py-16">
    <section class="grid items-center gap-8 md:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#c6ff2e]">Host guide</p>
        <h1 class="mt-3 text-4xl font-bold leading-[1.1] text-white md:text-5xl">How to run open play with Devlab Pickleball</h1>
        <p class="mt-4 text-lg text-[#b5c4e1]">{steps.length} steps, from an empty session to downloaded results. Free, with no sign-up for you or your players. Google sign-in is only for emailing yourself a DUPR export.</p>
      </div>
      <div class="pb-anim mx-auto w-full max-w-[16rem]" data-testid="pb-artwork"><ScoreTapArt className="w-full" /></div>
    </section>

    <ol class="mt-14 grid gap-4">
      {steps.map(({ title, body }, index) => (
        <li class="flex gap-4 rounded-2xl bg-[#11214d] p-5 md:p-6">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#c6ff2e] text-lg font-bold text-[#0b1426]" aria-hidden="true">{index + 1}</span>
          <div class="min-w-0">
            <h2 class="text-xl font-bold text-white">{title}</h2>
            <p class="mt-2 text-[#b5c4e1]">{body}</p>
          </div>
        </li>
      ))}
    </ol>

    <section class="mt-12 grid items-center gap-6 rounded-2xl border border-[#193480] p-6 md:grid-cols-[1fr_1.2fr]" aria-labelledby="tournament-heading">
      <div>
        <h2 id="tournament-heading" class="text-2xl font-bold text-white">Tournaments, the same way</h2>
        <p class="mt-2 text-[#b5c4e1]">The same free session, with a draw instead of a rotation. Captain links, the TV board, the results CSV and the 7-day deletion all work the same.</p>
      </div>
      <div class="pb-anim mx-auto w-full max-w-[20rem]" data-testid="pb-artwork"><BracketArt className="w-full" /></div>
    </section>

    <div class="mt-12 flex flex-wrap items-center gap-4">
      <a href="/pickleball/new" class="inline-flex min-h-12 items-center rounded-xl bg-[#4500ff] px-6 text-lg font-bold text-white hover:bg-[#3a00d6]">Start a free session</a>
      <a href="/pickleball/rotation" class="font-semibold text-white underline underline-offset-4">How fair rotation works</a>
    </div>
  </div>
</Layout>
