---
import Layout from '../../layouts/Layout.astro'
import HeroRallyArt from '../../components/pickleball/art/HeroRallyArt.jsx'
import PaddleStackArt from '../../components/pickleball/art/PaddleStackArt.jsx'
import ScoreTapArt from '../../components/pickleball/art/ScoreTapArt.jsx'
import QrBoardArt from '../../components/pickleball/art/QrBoardArt.jsx'
import {
  PaddleQueueIcon, FairnessBarsIcon, LinkedPlayersIcon, CourtGridIcon,
  WhistleIcon, TvBoardIcon, KeyIcon, BracketIcon, UploadFileIcon, ClockLockIcon,
} from '../../components/pickleball/art/FeatureIcons.jsx'
import ResumeBanner from '../../pickleball-open/ResumeBanner.jsx'
import ContactForm from '../../components/islands/ContactForm.jsx'
import { resolveTurnstileSiteKey } from '../../lib/turnstileSiteKey'
import { loadPageSeo } from '../../lib/content/seo'
import '../../styles/pickleball-open.css'

// Colours are explicit hex values rather than text-slate-* classes: the
// public shell is always dark and remaps slate classes (src/index.css), so
// hex keeps contrast independent of that remapping.
const seo = await loadPageSeo('pickleball')
const turnstileSiteKey = resolveTurnstileSiteKey(Astro.request.url)
// subjectPlaceholder is kept verbatim: the /api/contact subject handling for
// this form depends on it (CHANGELOG, "legacy /api/contact subject").
const accessFormCopy = {
  nameLabel: 'Your name',
  subjectLabel: 'Subject',
  subjectPlaceholder: 'Pickleball early access request',
  messageLabel: 'Tell us about your club',
  messagePlaceholder: 'Your club or venue, how many players and courts, and how often you run open play.',
  submitLabel: 'Send',
  helperText: 'We read every message personally.',
}

const steps = [
  { Art: PaddleStackArt, title: 'Add your players', body: 'Paste a list from Reclub, WhatsApp or anywhere, or let players check themselves in by QR. Numbering, emoji and duplicates are cleaned up for you. Late arrivals can join any time.' },
  { Art: ScoreTapArt, title: 'Tap the score when a game ends', body: 'Pick the winner and the losing score; the winning score fills itself in. The next fair match is ready on that court straight away.' },
  { Art: QrBoardArt, title: 'Everyone follows by QR', body: 'Players scan one code to see who is on every court, who is up next and the standings. No app, no account.' },
]

// The feature cards, grouped into three bands. Copy stays to one short line
// each (the guide has the detail); a few phrases are pinned by
// tests/e2e/pickleball/pickleball-public-pages.spec.js and must stay as-is.
const featureBands = [
  {
    id: 'run-courts',
    eyebrow: 'For the host',
    title: 'Run the courts',
    grid: 'sm:grid-cols-2 xl:grid-cols-4',
    features: [
      { Icon: PaddleQueueIcon, title: 'Fair rotation, your way', body: 'Whoever has played the fewest games always goes on next. Then pick the game mode: paddle stack, winners play winners, by standing or balanced teams. Switch any time.' },
      { Icon: FairnessBarsIcon, title: 'Fairness you can see', body: 'The live spread of games played, the longest current wait and how often partners repeat.' },
      { Icon: LinkedPlayersIcon, title: 'Keep friends together', body: 'Set two players to always partner or never share a court; every rotation keeps it.' },
      { Icon: CourtGridIcon, title: 'One person, every court', body: 'Up to 16 courts on one screen. Edit any game before it starts; undo or fix a score.' },
    ],
  },
  {
    id: 'share-game',
    eyebrow: 'For helpers and the hall',
    title: 'Share the game',
    grid: 'md:grid-cols-3',
    features: [
      { Icon: WhistleIcon, title: 'Court captains', body: 'Give a helper a link to run one court from their phone. Turn it off and it stops at once.' },
      { Icon: TvBoardIcon, title: 'A TV board for the venue', body: 'Every court, who is up next and the standings, in large type readable across the hall.' },
      { Icon: KeyIcon, title: 'Free, with no sign-up', body: 'No account for the host or the players. Your host link is your key; the board link is view‑only.' },
    ],
  },
  {
    id: 'tournaments-records',
    eyebrow: 'Beyond open play',
    title: 'Tournaments and records',
    grid: 'md:grid-cols-3',
    features: [
      { Icon: BracketIcon, title: 'Casual tournaments', body: 'Round robin, pools then a bracket, or single or double elimination, from a draw you can edit.' },
      { Icon: UploadFileIcon, title: 'DUPR export', body: 'Email yourself a CSV of every game with a valid score (no tie, a team reached 6) and four different DUPR IDs. Google sign-in is asked for this alone.' },
      { Icon: ClockLockIcon, title: 'Private by default', body: 'Sessions are deleted from the live service 7 days after their last change. Download the results first.' },
    ],
  },
]

const faqs = [
  { q: 'Is it really free?', a: 'Yes. Every court, every player, no paid tier.' },
  { q: 'Do players need an app or an account?', a: 'No. They scan the QR code or open the link in any browser. Nobody signs up.' },
  { q: 'What if I close the tab?', a: 'Nothing is lost: every tap is saved on our servers. Open the site on the same phone and choose “Resume as host”, or open your host link on another device.' },
  { q: 'How long are results kept?', a: 'Until 7 days after the last change to the session, then they are deleted. You can download a CSV of every game and the standings before that.' },
  { q: 'Can I send results to DUPR?', a: 'Yes, as the host. From More, choose Email me the DUPR export and sign in with Google. Every game with a valid score (no tie, a team reached 6) and four different DUPR IDs arrives in a CSV to upload in DUPR as a Club Director or Organizer, with a list of any game left out and why.' },
  { q: 'I lost my host link. Can I get it back?', a: 'If you linked the session to Google for a DUPR export, open My sessions on any device and sign in with that account. Otherwise the host link is the only key, so keep it safe.' },
  { q: 'Can I run a tournament?', a: 'Yes, for doubles: round robin, pools then a bracket, single elimination or double elimination. Generate the draw, edit it, then start; each free court is offered the next game.' },
  { q: 'Can I use it on a tablet, laptop or big screen?', a: 'Yes. The courts reflow to fit any screen, from a phone to a wide monitor, and the TV board shows every court in large type on a venue screen.' },
]
---
<Layout title="Devlab Pickleball: free open play manager" seo={seo}>
  <div class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <section class="grid items-center gap-10 md:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#c6ff2e]">Free · No sign-up · Up to 16 courts</p>
        <h1 class="mt-3 text-4xl font-bold leading-[1.05] text-white md:text-6xl">Run every court from one phone.</h1>
        <p class="mt-4 max-w-xl text-lg text-[#b5c4e1]">Add players, tap the score when a game ends, and the next fair match is ready. Everyone follows along by QR.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/pickleball/new" class="inline-flex min-h-12 items-center rounded-xl bg-[#4500ff] px-6 text-lg font-bold text-white hover:bg-[#3a00d6]">Start a free session</a>
          <a href="/pickleball/how-it-works" class="inline-flex min-h-12 items-center rounded-xl border border-[#193480] px-6 font-semibold text-white hover:bg-[#11214d]">See how it works</a>
        </div>
      </div>
      <div class="pb-anim" data-testid="pb-artwork"><HeroRallyArt className="w-full" /></div>
    </section>

    <ResumeBanner client:load />

    <section class="mt-20" aria-labelledby="steps-heading">
      <h2 id="steps-heading" class="text-3xl font-bold text-white">Three steps, then just play</h2>
      <ol class="mt-8 grid gap-5 md:grid-cols-3">
        {steps.map(({ Art, title, body }, index) => (
          <li class="rounded-2xl bg-[#11214d] p-6">
            <div class="pb-anim h-36 text-white" data-testid="pb-artwork"><Art className="h-full w-full" /></div>
            <p class="mt-4 text-sm font-bold text-[#c6ff2e]">Step {index + 1}</p>
            <h3 class="mt-1 text-xl font-bold text-white">{title}</h3>
            <p class="mt-2 text-[#b5c4e1]">{body}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="mt-20 space-y-14">
      {featureBands.map(({ id, eyebrow, title, grid, features }) => (
        <section aria-labelledby={`${id}-heading`}>
          <p class="text-sm font-semibold text-[#c6ff2e]">{eyebrow}</p>
          <div class="mt-1 flex items-center gap-5">
            <h2 id={`${id}-heading`} class="shrink-0 text-2xl font-bold text-white md:text-3xl">{title}</h2>
            <span class="h-px flex-1 bg-[#193480]" aria-hidden="true"></span>
          </div>
          <ul class={`mt-6 grid gap-4 ${grid}`}>
            {features.map(({ Icon, title: featureTitle, body }) => (
              <li class="flex gap-4 rounded-2xl border border-[#193480] bg-[#0f1d47] p-5 transition-transform duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:flex-col">
                <div class="pb-anim flex h-12 w-12 shrink-0 items-center justify-center rounded-xl sm:h-14 sm:w-14 sm:rounded-2xl bg-[#c6ff2e]/10 ring-1 ring-inset ring-[#c6ff2e]/25" data-testid="pb-artwork">
                  <Icon className="h-8 w-8 sm:h-10 sm:w-10" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white">{featureTitle}</h3>
                  <p class="mt-1 text-[15px] leading-relaxed text-[#b5c4e1]">{body}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <section class="mt-20" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-3xl font-bold text-white">Questions</h2>
      <div class="mt-6 grid gap-3">
        {faqs.map(({ q, a }) => (
          <details class="rounded-2xl bg-[#11214d] p-5">
            <summary class="cursor-pointer text-lg font-semibold text-white">{q}</summary>
            <p class="mt-2 text-[#b5c4e1]">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="request-access" class="mt-20 scroll-mt-24">
      <h2 class="text-3xl font-semibold text-white">Running a club or venue?</h2>
      <p class="mt-3 max-w-2xl text-[#b5c4e1]">Tell us about your sessions and we'll help you set it up.</p>
      <div class="mt-8 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200">
        <ContactForm client:visible siteKey={turnstileSiteKey} copy={accessFormCopy} />
      </div>
    </section>
  </div>
</Layout>
