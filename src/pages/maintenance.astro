---
/**
 * Maintenance (BRAND-04, UX-04): on the brand shell, with no fixed return
 * time. Middleware serves it while site_settings.maintenance_mode is on.
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import NodeMascot from '../components/brand/NodeMascot.jsx'
import { COMPANY } from '../config/company.js'
import { ERROR_MESSAGES } from '../config/errorMessages.js'

const { title, message, details } = ERROR_MESSAGES.MAINTENANCE_MODE
---

<BrandLayout title={`${title} · DevLab Studios`} robots="noindex, nofollow">
  <PageHeader eyebrow="Maintenance" heading={title} lead={message}>
    <button type="button" id="maintenance-refresh" class="dl-button-primary" data-needs-js hidden>Refresh the page</button>
    <a href={`mailto:${COMPANY.publicEmail}`} class="dl-button-quiet" data-cta-id="maintenance-email">{COMPANY.publicEmail}</a>
    <NodeMascot slot="aside" state="idle" id="maintenance-node" className="mx-auto" />
  </PageHeader>
  <p class="mx-auto max-w-container px-[var(--gutter)] py-12 text-dl-ink-2">{details}</p>
</BrandLayout>

<script>
  const refresh = document.getElementById('maintenance-refresh')
  if (refresh) {
    refresh.hidden = false
    refresh.addEventListener('click', () => window.location.reload())
  }
</script>
