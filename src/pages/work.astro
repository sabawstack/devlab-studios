---
/**
 * Work index (spec K.2, CASE-02): systems we have built, described honestly.
 * Each entry: the problem, what it does, the scope line when written, a real
 * screenshot on a white mount, and one link to its write-up (the "talk to us
 * about something similar" action lives on the write-up). Starter templates
 * are not shown (WEB-07 / BUS-F04).
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import ProofMount from '../components/brand/ProofMount.astro'
import { createFigureCounter } from '../components/brand/figures'
import { getBreadcrumbSchema } from '../config/schema.js'
import { loadPageSeo } from '../lib/content/seo'
import { draftPreviewFor } from '../lib/content/preview'
import { loadWorkEntries } from '../lib/content/work'
import { WORK_INDEX } from '../data/site/content.js'

const seo = await loadPageSeo('work')
const entries = await loadWorkEntries({ includeDrafts: await draftPreviewFor(Astro, { type: 'page', id: 'work' }) })
const figures = createFigureCounter()
const jsonLd = [getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work' }])]
---

<BrandLayout title="Work · DevLab Studios" seo={seo} jsonLd={jsonLd}>
  <PageHeader eyebrow={WORK_INDEX.eyebrow} heading={WORK_INDEX.heading} lead={WORK_INDEX.lead} />

  <section aria-labelledby="work-list-heading">
    <h2 id="work-list-heading" class="sr-only">Selected systems</h2>
    <ol class="mx-auto max-w-container px-[var(--gutter)]">
      {entries.map((entry, index) => {
        const picture = entry.project.optimizedImage
        return (
          <li class="grid gap-8 border-b border-dl-rule py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center" data-work-entry={entry.slug}>
            <div>
              <p class="label text-dl-ink-3">{String(index + 1).padStart(2, '0')} · {entry.project.type}</p>
              <h3 class="mt-2 text-step-2"><a href={`/work/${entry.slug}`} class="no-underline">{entry.project.title}</a></h3>
              <dl class="mt-5 grid gap-4">
                <div><dt class="label text-dl-ink-3">The problem</dt><dd class="mt-1 text-dl-ink-2">{entry.problem}</dd></div>
                <div><dt class="label text-dl-ink-3">What it does</dt><dd class="mt-1 text-dl-ink-2">{entry.value}</dd></div>
                {entry.scope && <div data-scope-line><dt class="label text-dl-ink-3">Scope</dt><dd class="mt-1 text-dl-ink-2">{entry.scope}</dd></div>}
              </dl>
              <a href={`/work/${entry.slug}`} class="dl-button-quiet mt-6" data-cta-id="work-read">Read the write-up<span class="sr-only">: {entry.project.title}</span></a>
            </div>
            {picture && <ProofMount picture={picture} caption={`${entry.project.title}: the workflow as built.`} number={figures.next()} />}
          </li>
        )
      })}
    </ol>
    <p class="mx-auto max-w-container px-[var(--gutter)] py-10 text-step--1 text-dl-ink-3" data-evidence-standard>
      Client names, revenue figures and percentage improvements appear only where the client has agreed and the figure can be evidenced.
    </p>
  </section>
</BrandLayout>
