---
/**
 * One page per service line, plus the Workflow Systems Audit (audit UX-07,
 * BUS-02, G.1, BR.9): what the system does for you, what it includes, one
 * piece of proof, questions, and a typed contact link. Unknown slugs 404.
 */
import BrandLayout from '../../layouts/BrandLayout.astro'
import PageHeader from '../../components/brand/PageHeader.astro'
import Section from '../../components/brand/Section.astro'
import SceneFrame from '../../components/brand/SceneFrame.astro'
import FaqList from '../../components/brand/FaqList.astro'
import { createFigureCounter } from '../../components/brand/figures'
import { getBreadcrumbSchema, getFaqSchema, getServiceSchema } from '../../config/schema.js'
import { loadWorkEntries } from '../../lib/content/work'
import { loadPageSeo, type SeoData } from '../../lib/content/seo'
import { loadSiteSettings } from '../../lib/content/siteSettings'
import { AUDIT_PAGE, OFFER_AUDIT, SERVICE_LINES, serviceLineContactHref } from '../../data/site/content.js'

const { slug } = Astro.params as { slug: string }
const line = SERVICE_LINES.find((candidate) => candidate.slug === slug) || null
const isAudit = slug === OFFER_AUDIT.slug

if (!line && !isAudit) {
  return Astro.rewrite('/404')
}

const figures = createFigureCounter()
const path = `/solutions/${slug}`
const title = line ? line.title : OFFER_AUDIT.title
const description = line ? `${line.problem} ${line.outcome}` : OFFER_AUDIT.summary
const { business } = await loadSiteSettings()
// BUS-05: the audit's price line comes from site settings (owner Q-02), in the page and the FAQ answer.
const auditFaq = AUDIT_PAGE.faq.map((item) => (item.id === 'price' ? { ...item, answer: `${business.auditPriceLine}. The scope is fixed and agreed before any work starts.` } : item))
const faq = line ? line.faq : auditFaq
const work = line?.workProjectId ? (await loadWorkEntries()).find((entry) => entry.project.id === line.workProjectId) || null : null

const fallbackSeo: SeoData = {
  metaTitle: `${title} · DevLab Studios`,
  metaDescription: description.slice(0, 160),
  canonicalUrl: `https://www.devlabstudios.com${path}`,
  ogTitle: title,
  ogDescription: description.slice(0, 200),
}
const seo: SeoData = (await loadPageSeo(`solutions/${slug}`)) || fallbackSeo
const jsonLd = [
  getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Solutions', path: '/solutions' }, { name: title, path }]),
  getServiceSchema({ id: slug, title, description, capabilities: line ? line.includes : AUDIT_PAGE.receive, path }),
  getFaqSchema(faq),
]
const breadcrumb = [{ label: 'Solutions', href: '/solutions' }]
---

<BrandLayout title={seo.metaTitle || 'DevLab Studios'} seo={seo} jsonLd={jsonLd}>
  {line ? (
    <>
      <PageHeader breadcrumb={breadcrumb} eyebrow="Service line" heading={line.title} lead={line.lead}>
        <a href={serviceLineContactHref(line)} class="dl-button-primary" data-cta-id={`solution-${line.slug}-primary`} data-inquiry-type={line.inquiryType}>{line.ctaLabel}</a>
        {work && <a href={`/work/${work.slug}`} class="dl-button-quiet" data-cta-id={`solution-${line.slug}-work`}>Read the write-up</a>}
        <SceneFrame slot="aside" sceneId={line.sceneId} figure={figures.next()} />
      </PageHeader>

      <Section id="solution-outcome" eyebrow="What changes" heading={line.problem}>
        <p class="mt-4 text-step-1 text-dl-ink">{line.outcome}</p>
      </Section>

      <Section id="solution-includes" eyebrow="What it includes" heading="Built around the work, not a template." class="border-t border-dl-rule">
        <ol class="mt-8 grid gap-px overflow-hidden rounded-dl-s border border-dl-rule bg-dl-rule sm:grid-cols-2 lg:grid-cols-3">
          {line.includes.map((item, index) => (
            <li class="flex gap-4 bg-dl-paper p-5">
              <span class="label shrink-0 pt-1 text-dl-ink-3">{String(index + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </Section>

      {work ? (
        <Section id="solution-proof" eyebrow="Proof" heading={work.project.title} class="border-t border-dl-rule">
          <p class="mt-4 text-dl-ink-2">{work.problem}</p>
          <p class="mt-3 text-dl-ink-2">{work.value}</p>
          <a href={`/work/${work.slug}`} class="dl-button-quiet mt-6" data-cta-id={`solution-${line.slug}-proof`}>Read the write-up</a>
        </Section>
      ) : line.productProof ? (
        <Section id="solution-proof" eyebrow="Proof" heading={line.productProof.title} class="border-t border-dl-rule">
          <p class="mt-4 text-dl-ink-2">{line.productProof.text}</p>
          <a href={line.productProof.href} class="dl-button-quiet mt-6" data-cta-id={`solution-${line.slug}-proof`}>See the product</a>
        </Section>
      ) : null}
    </>
  ) : (
    <>
      <PageHeader breadcrumb={breadcrumb} eyebrow={AUDIT_PAGE.eyebrow} heading={AUDIT_PAGE.heading} lead={AUDIT_PAGE.lead}>
        <a href={OFFER_AUDIT.contactHref} class="dl-button-primary" data-cta-id="audit-primary" data-inquiry-type="workflow_audit">Request the audit</a>
        <a href="/contact?type=workflow_audit" class="dl-button-quiet" data-cta-id="audit-question">Ask a question first</a>
        <SceneFrame slot="aside" sceneId="workflow-audit" figure={figures.next()} />
      </PageHeader>

      <Section id="audit-who" eyebrow="Who it is for" heading="For a process you know is costing time.">
        <ul class="mt-8 grid gap-3">
          {AUDIT_PAGE.whoFor.map((item) => <li class="flex gap-3 text-dl-ink-2"><span aria-hidden="true" class="label pt-1 text-dl-ink-3">—</span>{item}</li>)}
        </ul>
      </Section>

      <Section id="audit-receive" eyebrow="What you receive" heading="A written recommendation, in this order." class="border-t border-dl-rule">
        <ol class="mt-8 divide-y divide-dl-rule border-y border-dl-rule">
          {AUDIT_PAGE.receive.map((item, index) => (
            <li class="flex gap-4 py-4">
              <span class="label shrink-0 pt-1 text-dl-ink-3">{String(index + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
        <p class="mt-6 text-step-1 font-semibold" data-audit-price>Price: {business.auditPriceLine}</p>
      </Section>

      <Section id="audit-steps" eyebrow="How it runs" heading="Three steps." class="border-t border-dl-rule">
        <ol class="mt-8 grid gap-px overflow-hidden rounded-dl-s border border-dl-rule bg-dl-rule md:grid-cols-3">
          {AUDIT_PAGE.steps.map((step, index) => (
            <li class="bg-dl-paper p-6">
              <p class="label text-dl-ink-3">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-step-1">{step.title}</h3>
              <p class="mt-2 text-dl-ink-2">{step.text}</p>
            </li>
          ))}
        </ol>
      </Section>
    </>
  )}

  <Section id="solution-faq" eyebrow="Questions" heading="Before you get in touch" class="border-t border-dl-rule">
    <FaqList items={faq} class="mt-8" />
  </Section>

  <section id="solution-cta" aria-labelledby="solution-cta-heading" class="dl-band">
    <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)]">
      <h2 id="solution-cta-heading" class="max-w-3xl text-step-3">{line ? 'Describe the workflow. A person replies.' : 'Choose the workflow to review.'}</h2>
      <p class="mt-4 text-step-1 text-dl-ink-2">You get an automatic receipt; the reply itself comes from a person.</p>
      <a
        href={line ? serviceLineContactHref(line) : OFFER_AUDIT.contactHref}
        class="dl-button-primary mt-8"
        data-cta-id={line ? `solution-${line.slug}-final` : 'audit-final'}
        data-inquiry-type={line ? line.inquiryType : 'workflow_audit'}
      >{line ? line.ctaLabel : 'Request the audit'}</a>
    </div>
  </section>
</BrandLayout>
