---
/**
 * Article template (audit UX-09 / WEB-06 / BR.9): problem tag, title, summary,
 * byline, optional scene header, the body in the long-form serif, and beside it
 * the related service line, the audit and the checklist. Draft preview works
 * through a signed link (CMS-04). Unknown slugs return the site's 404.
 */
import BrandLayout from '../../layouts/BrandLayout.astro'
import SceneFrame from '../../components/brand/SceneFrame.astro'
import { draftPreviewFor } from '../../lib/content/preview'
import { loadArticlesContent, parseArticleBody, formatArticleDate, type ArticlePost } from '../../lib/content/articles'
import { getArticleSchema, getBreadcrumbSchema } from '../../config/schema.js'
import { getLeadMagnet } from '../../config/offers.js'
import { getScene } from '../../config/scenes'
import { PROBLEM_TAGS } from '../../config/problemTags.js'
import type { SeoData } from '../../lib/content/seo'
import { OFFER_AUDIT, serviceLineForProblemTag } from '../../data/site/content.js'

type Post = ArticlePost & { problemTag?: string; heroVisualId?: string; seoTitle?: string; seoDescription?: string; updatedAt?: string }

const { slug } = Astro.params
const isPreview = await draftPreviewFor(Astro, { type: 'article', id: String(slug) })
const { posts } = await loadArticlesContent({ includeDrafts: isPreview })
const all = posts as Post[]
const published = all.filter((post) => post.status !== 'draft' && post.status !== 'archived')
const post = published.find((candidate) => candidate.slug === slug || candidate.id === slug)
  || (isPreview ? all.find((candidate) => candidate.slug === slug) : undefined)
  || null

if (!post) {
  return Astro.rewrite('/404')
}

const canonical = `https://www.devlabstudios.com/insights/${post.slug}`
const image = post.coverImageUrl || 'https://www.devlabstudios.com/og.png'
const seo: SeoData = {
  metaTitle: post.seoTitle || `${post.title} · DevLab Studios`,
  metaDescription: post.seoDescription || post.summary,
  canonicalUrl: canonical,
  ogTitle: post.seoTitle || post.title,
  ogDescription: post.seoDescription || post.summary,
  ogImage: image,
  twitterTitle: post.seoTitle || post.title,
  twitterDescription: post.seoDescription || post.summary,
  twitterImage: image,
}
const body = parseArticleBody(post.body)
const tag = PROBLEM_TAGS.find((candidate) => candidate.id === post.problemTag) || null
const scene = post.heroVisualId ? getScene(post.heroVisualId) : null
const line = serviceLineForProblemTag(post.problemTag)
const related = published.filter((candidate) => candidate.id !== post.id && candidate.problemTag && candidate.problemTag === post.problemTag).slice(0, 3)
const leadMagnet = getLeadMagnet('lead-intake-checklist')
const jsonLd = [
  getArticleSchema(post),
  getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Insights', path: '/insights' }, { name: post.title, path: `/insights/${post.slug}` }]),
]
---

<BrandLayout title={seo.metaTitle || 'DevLab Studios'} seo={seo} jsonLd={jsonLd} longform>
  <article data-view-event="insight_view" data-insight-id={post.slug}>
    <header class="border-b border-dl-rule">
      <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.5)]">
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="label flex flex-wrap gap-2 text-dl-ink-3">
            <li><a href="/insights" class="no-underline hover:underline">Insights</a></li>
            {tag && <li class="before:mr-2 before:content-['/']"><a href={`/insights?problem=${tag.id}`} class="no-underline hover:underline">{tag.label}</a></li>}
          </ol>
        </nav>
        <h1 class="max-w-4xl text-step-4">{post.title}</h1>
        <p class="mt-5 text-step-1 text-dl-ink-2">{post.summary}</p>
        <p class="label mt-6 text-dl-ink-3">
          {post.authorName || 'DevLab Studios'}
          {post.publishedAt && <span> · <time datetime={post.publishedAt}>{formatArticleDate(post.publishedAt)}</time></span>}
          {post.readingTimeMinutes ? <span> · {post.readingTimeMinutes} min read</span> : null}
        </p>
        {scene && <SceneFrame sceneId={scene.id} figure={1} class="mt-10 max-w-3xl" />}
      </div>
    </header>

    <div class="mx-auto grid max-w-container gap-12 px-[var(--gutter)] py-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="brand-longform max-w-[68ch]">
        {body.map((block) => {
          if (block.type === 'heading') return <h2 class="mt-10 font-display text-step-2 first:mt-0">{block.text}</h2>
          if (block.type === 'list') return (
            <ul class="mt-5 grid gap-2 pl-5 [list-style:square]">
              {block.items.map((item) => <li>{item}</li>)}
            </ul>
          )
          return <p class="mt-5 first:mt-0">{block.text}</p>
        })}
      </div>

      <aside class="grid content-start gap-6">
        {line && (
          <div class="rounded-dl-s border border-dl-rule p-6">
            <p class="label text-dl-ink-3">Related service</p>
            <p class="mt-2 font-semibold">{line.title}</p>
            <p class="mt-2 text-step--1 text-dl-ink-2">{line.outcome}</p>
            <a href={`/solutions/${line.slug}`} class="dl-button-quiet mt-3" data-cta-id="insight-related-solution" data-solution-id={line.solutionId} data-insight-id={post.slug}>What this includes</a>
          </div>
        )}
        <div class="ink-panel rounded-dl-s p-6">
          <p class="label text-dl-ink-3">Start here</p>
          <p class="mt-2 text-step-1 font-semibold">{OFFER_AUDIT.title}</p>
          <p class="mt-2 text-step--1 text-dl-ink-2">{OFFER_AUDIT.summary}</p>
          <a href={`${OFFER_AUDIT.contactHref}&insight=${encodeURIComponent(post.slug)}`} class="dl-button-primary mt-5" data-cta-id="insight-audit" data-insight-id={post.slug} data-inquiry-type="workflow_audit">Request the audit</a>
        </div>
        {leadMagnet && (
          <div class="rounded-dl-s border border-dl-rule p-6">
            <p class="label text-dl-ink-3">Free checklist</p>
            <p class="mt-2 font-semibold">{leadMagnet.title}</p>
            <a href={`/offers/${leadMagnet.id}`} class="dl-button-quiet mt-3" data-cta-id="insight-lead-magnet" data-offer-id={leadMagnet.id} data-insight-id={post.slug}>Get the checklist</a>
          </div>
        )}
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section aria-labelledby="related-heading" class="border-t border-dl-rule">
      <div class="mx-auto max-w-container px-[var(--gutter)] py-12">
        <h2 id="related-heading" class="text-step-2">More on {tag?.label.toLowerCase()}</h2>
        <ul class="mt-6 grid gap-6 md:grid-cols-3">
          {related.map((item) => (
            <li class="border-t border-dl-rule pt-4">
              <a href={`/insights/${item.slug}`} class="font-semibold no-underline hover:underline" data-cta-id="insight-related-article">{item.title}</a>
              <p class="mt-2 text-step--1 text-dl-ink-2">{item.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BrandLayout>
