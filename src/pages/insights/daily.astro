---
import { CTA } from '../../config/ctas.js'
import BrandLayout from '../../layouts/BrandLayout.astro'
import PageHeader from '../../components/brand/PageHeader.astro'
import { loadDigests, formatDigestDate, sourceHost } from '../../lib/content/digests'
import { RETENTION_DAYS } from '../../worker/digest/feeds.js'
import { getBreadcrumbSchema } from '../../config/schema.js'

/**
 * AI & Automation Daily — a dated log on one permanent URL (BRAND-04: brand shell).
 *
 * Deliberately NOT one page per day. Each day's digest is a handful of
 * summarized links; a separate indexable page per day would be a thin-content
 * page generated on a schedule, which is what Google's "scaled content abuse"
 * policy targets. One durable page with dated sections and `#YYYY-MM-DD`
 * anchors is linkable without manufacturing URLs.
 */
const digests = await loadDigests(RETENTION_DAYS)
const latest = digests[0] || null

const seo = {
  metaTitle: 'AI & Automation Daily — DevLab Studios',
  metaDescription:
    'A short daily log of AI automation and AI advancement stories worth reading, summarized and linked to the original source.',
  canonicalUrl: 'https://www.devlabstudios.com/insights/daily',
}

const jsonLd = [
  getBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/insights' },
    { name: 'AI & Automation Daily', path: '/insights/daily' },
  ]),
]
---

<BrandLayout title="AI & Automation Daily · DevLab Studios" seo={seo} jsonLd={jsonLd}>
  <PageHeader breadcrumb={[{ label: 'Insights', href: '/insights' }]} eyebrow="Daily log" heading="AI & Automation Daily" lead={`A short daily pass over AI automation and AI advancement news. Each item is summarized in a sentence and linked to the publisher: read the summary to decide, then read the source. The last ${RETENTION_DAYS} days are kept here.`}>
    <a href="/insights" class="dl-button-quiet" data-cta-id="digest-hero-insights" data-cta-variant="secondary">All Insights</a>
  </PageHeader>
  <p class="mx-auto max-w-container px-[var(--gutter)] pt-8 text-step--1 text-dl-ink-3" data-disclosure>
    Summaries are machine-generated from each publisher's own headline and excerpt, then linked back to the original. DevLab Studios does not author, endorse, or verify the linked reporting.
  </p>

  {digests.length === 0 ? (
    <section class="mx-auto max-w-container px-[var(--gutter)] py-12" aria-labelledby="digest-empty-heading">
      <h2 id="digest-empty-heading" class="text-step-2">No digest yet</h2>
      <p class="mt-3 max-w-prose text-dl-ink-2">The next edition publishes after the daily run. In the meantime, the long-form guides and implementation notes are on the main Insights page.</p>
      <a href="/insights" class="dl-button-quiet mt-4" data-cta-id="digest-empty-insights">Read Insights</a>
    </section>
  ) : (
    <section class="mx-auto max-w-container px-[var(--gutter)] py-12" aria-labelledby="digest-latest-heading">
      <h2 id="digest-latest-heading" class="text-step-3">Latest editions</h2>
      <p class="mt-2 text-dl-ink-3">Newest first.{latest ? ` Last updated ${formatDigestDate(latest.digestDate)}.` : ''}</p>
      {digests.map((digest, digestIndex) => (
        <article id={digest.digestDate} class="scroll-mt-24 border-t border-dl-rule py-8 first-of-type:mt-8">
          <h3 class="text-step-2"><a href={`#${digest.digestDate}`} class="no-underline"><time datetime={digest.digestDate}>{formatDigestDate(digest.digestDate)}</time></a></h3>
          <p class="mt-1 text-step--1 text-dl-ink-3">{digest.itemCount} {digest.itemCount === 1 ? 'story' : 'stories'}{digestIndex === 0 ? ' · latest edition' : ''}</p>
          <ol class="mt-5 divide-y divide-dl-rule">
            {digest.items.map((item) => (
              <li class="py-4">
                <h4 class="text-step-1 font-semibold">
                  <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer nofollow" class="no-underline" data-cta-id="digest-item" data-cta-variant="link">
                    {item.title}<span class="sr-only"> (opens on {sourceHost(item.sourceUrl)} in a new tab)</span>
                  </a>
                </h4>
                {item.summary ? <p class="mt-2 max-w-prose text-dl-ink-2">{item.summary}</p> : null}
                <p class="mt-2 text-step--1 text-dl-ink-3">{item.sourceName}{sourceHost(item.sourceUrl) ? ` · ${sourceHost(item.sourceUrl)}` : ''}</p>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </section>
  )}

  <section aria-labelledby="digest-cta-heading" class="dl-band">
    <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)]">
      <h2 id="digest-cta-heading" class="max-w-3xl text-step-3">Want one of these working in your business?</h2>
      <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2">Most of what lands here is a capability before it is a product. If something in the log solves a problem you actually have, we can scope what it would take to run it in your operation.</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/contact?type=business_system" class="dl-button-primary" data-cta-id="digest-final-primary" data-cta-variant="primary" data-inquiry-type="business_system">{CTA.primary}</a>
        <a href="/solutions" class="dl-button-quiet" data-cta-id="digest-final-secondary" data-cta-variant="secondary">View Solutions</a>
      </div>
    </div>
  </section>
</BrandLayout>
