---
/**
 * Founder profile (audit UX-12 / PROF-01..04 / BR.9): for recruiters and
 * technical leads. Primary actions are the résumé and contact-for-role; the
 * business CTA is never primary here (G.3). Rendered as static markup: no
 * marquee, no gallery islands, lazy images with descriptive alt text, and only
 * city-level personal details (toPublicAbout on the read path).
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import Section from '../components/brand/Section.astro'
import Portrait from '../components/brand/Portrait.astro'
import Tag from '../components/brand/Tag.astro'
import { getBreadcrumbSchema, getPersonSchema } from '../config/schema.js'
import { COMPANY } from '../config/company.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadProfileContent } from '../lib/content/profile'
import { loadWorkEntries } from '../lib/content/work'
import { optimizeImage } from '../lib/images/optimizeImage'
import { coreTools } from '../data/tools.js'
import profilePhoto from '../assets/recent-photo.png'

const seo = await loadPageSeo('profile')
const [profile, work] = await Promise.all([loadProfileContent(), loadWorkEntries()])
const about = profile.about || {}
const experiences = profile.experiences || []
const certifications = profile.certifications || []
const skills = profile.skills?.technical || []
const schemaPhoto = await optimizeImage(profilePhoto, { width: 320, height: 320, fit: 'cover' })

/** Each area is evidenced elsewhere on this page (experience, certifications, work). */
const capabilityAreas = [
  { title: 'Full-stack development', items: ['React and Astro interfaces', 'Server-rendered applications on Cloudflare Workers', 'Design systems in Tailwind'] },
  { title: 'Backend and APIs', items: ['Java and Spring Boot services', 'Laravel applications', 'REST APIs, webhooks and SQL data models'] },
  { title: 'AI automation', items: ['n8n, Make and Zapier orchestration', 'AI-assisted classification and drafting', 'Human approval steps'] },
  { title: 'Operations and delivery', items: ['CRM and third-party integrations', 'Dashboards and reporting', 'Deployment, documentation and handover'] },
]
/** Employer names only; office addresses stay off the page. */
const employer = (company: string) => company.split(' — ')[0]

const jsonLd = [
  getPersonSchema({
    image: schemaPhoto?.src ? new URL(schemaPhoto.src, Astro.url).toString() : undefined,
    credentials: certifications.map((cert) => cert.name).filter(Boolean),
  }),
  getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Founder Profile', path: '/profile' }]),
]
---

<BrandLayout title="Stephen Rey Agustinez · Founder Profile" seo={seo} jsonLd={jsonLd}>
  <PageHeader eyebrow="Founder profile" heading="Stephen Rey Agustinez">
    <p class="w-full text-step-1 font-semibold text-dl-ink" data-profile-role>Founder, Full-Stack Developer, and AI Automation Architect</p>
    <p class="w-full max-w-[68ch] text-dl-ink-2">Stephen designs and builds the systems delivered through {COMPANY.name}: interfaces, backend services, APIs, databases, AI workflows and operational automation. He is also open to suitable remote employment, contract and collaboration work.</p>
    <a href="/resume.pdf" target="_blank" rel="noopener" class="dl-button-primary" data-cta-id="profile-hero-resume" data-cta-variant="primary">View Resume</a>
    <a href="/contact?type=employment_opportunity" class="dl-button-quiet" data-cta-id="profile-hero-contact" data-inquiry-type="employment_opportunity">Contact Stephen</a>
    <a href="#portfolio" class="dl-button-quiet" data-cta-id="profile-hero-work">View Selected Work</a>
    <div slot="aside" class="flex flex-col gap-6">
      <Portrait size={200} loading="eager" />
      <dl class="grid gap-3 border-t border-dl-rule pt-5">
        <div><dt class="label text-dl-ink-3">Based in</dt><dd>{about.location || COMPANY.locationLabel}</dd></div>
        <div><dt class="label text-dl-ink-3">Email</dt><dd><a href={`mailto:${about.email || COMPANY.publicEmail}`}>{about.email || COMPANY.publicEmail}</a></dd></div>
        <div><dt class="label text-dl-ink-3">Elsewhere</dt><dd class="flex gap-4"><a href="https://www.linkedin.com/in/stephen-rey-agustinez-8b86041b3" rel="noopener" target="_blank">LinkedIn</a><a href="https://github.com/stpn-dev" rel="noopener" target="_blank">GitHub</a></dd></div>
      </dl>
    </div>
  </PageHeader>

  {about.about && (
    <Section id="about" eyebrow="About" heading="Background">
      <p class="mt-4 text-step-1 text-dl-ink-2">{about.about}</p>
    </Section>
  )}

  <Section id="capabilities" eyebrow="Capabilities" heading="What Stephen builds" class="border-t border-dl-rule">
    <div class="mt-8 grid gap-px overflow-hidden rounded-dl-s border border-dl-rule bg-dl-rule sm:grid-cols-2 lg:grid-cols-4">
      {capabilityAreas.map((area) => (
        <div class="bg-dl-paper p-5">
          <h3 class="text-step-1">{area.title}</h3>
          <ul class="mt-3 grid gap-1.5 text-step--1 text-dl-ink-2">{area.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      ))}
    </div>
    {skills.length > 0 && (
      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Technical skills">{skills.map((skill) => <li><Tag>{skill}</Tag></li>)}</ul>
    )}
  </Section>

  <Section id="experience" eyebrow="Experience" heading="Where the work has been" class="border-t border-dl-rule">
    <ol class="mt-8 divide-y divide-dl-rule border-y border-dl-rule">
      {experiences.map((item) => (
        <li class="grid gap-3 py-6 md:grid-cols-[14rem_minmax(0,1fr)]">
          <p class="label text-dl-ink-3">{item.dates}</p>
          <div>
            <h3 class="text-step-1">{item.role}</h3>
            <p class="text-dl-ink-2">{employer(item.company)}</p>
            <ul class="mt-3 grid list-[square] gap-1.5 pl-5 text-step--1 text-dl-ink-2">{item.bullets.slice(0, 4).map((bullet) => <li>{bullet}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="education" eyebrow="Education" heading="Education and responsibilities" class="border-t border-dl-rule">
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {(about.education || []).map((item) => (
        <li><p class="font-semibold">{item.program}</p><p class="text-dl-ink-2">{item.school}</p><p class="label mt-1 text-dl-ink-3">{item.years}</p></li>
      ))}
      {(about.achievementsAndResponsibilities || []).map((item) => (
        <li><p class="font-semibold">{item.title}</p><p class="text-dl-ink-2">{item.details}</p></li>
      ))}
    </ul>
  </Section>

  <Section id="certifications" eyebrow="Credentials" heading="Certifications" class="border-t border-dl-rule">
    {(about.certificatesAndLicenses || []).length > 0 && (
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {(about.certificatesAndLicenses || []).map((cert) => (
          <li class="border-l border-dl-rule pl-4"><p>{cert.name}</p><p class="label mt-1 text-dl-ink-3">{[cert.issuer, cert.date].filter(Boolean).join(' · ')}</p></li>
        ))}
      </ul>
    )}
    {certifications.length > 0 && (
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" aria-label="Platform training certificates">
        {certifications.map((cert) => {
          const full = cert.badgeImageFull?.src || cert.credentialUrl
          return (
            <li>
              {cert.badgeImage ? (
                <a href={full || undefined} target="_blank" rel="noopener" class="block rounded-dl-s border border-dl-rule bg-dl-paper p-2" aria-label={`View ${cert.name} certificate full size`}>
                  <picture>
                    <source type="image/avif" srcset={cert.badgeImage.avifSrcSet} />
                    <source type="image/webp" srcset={cert.badgeImage.webpSrcSet} />
                    <img src={cert.badgeImage.src} width={cert.badgeImage.width} height={cert.badgeImage.height} alt={`${cert.name} certificate issued by ${cert.issuer}`} loading="lazy" decoding="async" class="h-auto w-full" />
                  </picture>
                </a>
              ) : null}
              <p class="mt-2 text-step--1">{cert.name}</p>
              <p class="label text-dl-ink-3">{[cert.issuer, cert.issuedDate].filter(Boolean).join(' · ')}</p>
            </li>
          )
        })}
      </ul>
    )}
  </Section>

  <Section id="tools" eyebrow="Tools" heading="Tools and platforms" class="border-t border-dl-rule">
    <ul class="mt-8 flex flex-wrap gap-2" aria-label="Tools and platforms in regular use">{coreTools.map((tool) => <li><Tag>{tool.label}</Tag></li>)}</ul>
  </Section>

  <Section id="portfolio" eyebrow="Selected work" heading="Systems written up in full" class="scroll-mt-24 border-t border-dl-rule">
    <ul class="mt-8 divide-y divide-dl-rule border-y border-dl-rule">
      {work.map((entry) => (
        <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
          <a href={`/work/${entry.slug}`} class="font-semibold" data-cta-id="profile-work-item">{entry.project.title}</a>
          <span class="label text-dl-ink-3">{entry.project.type}</span>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-dl-ink-2">More builds and the products Stephen runs are on <a href="/work">Work</a> and <a href="/products">Products</a>.</p>
  </Section>

  <section id="availability" aria-labelledby="availability-heading" class="dl-band">
    <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)]">
      <h2 id="availability-heading" class="text-step-3">Employment and collaboration</h2>
      <p class="mt-4 text-step-1 text-dl-ink-2">Open to suitable remote full-time, part-time and contract roles, and technical collaboration. This goes straight to Stephen, not through the business questions.</p>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
        <a href="/contact?type=employment_opportunity" class="dl-button-primary" data-cta-id="profile-availability-contact" data-inquiry-type="employment_opportunity">Contact Stephen about a role</a>
        <a href="/contact?type=contract_collaboration" class="dl-button-quiet" data-cta-id="profile-availability-contract" data-inquiry-type="contract_collaboration">Discuss a contract or collaboration</a>
      </div>
    </div>
  </section>
</BrandLayout>
