---
import '../../index.css'
import AdminApp from '../../admin-app/AdminApp.jsx'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <!--
      This page builds its own document rather than using a site layout, which is
      how it ended up as the only one on the site with no icon: the browser fell
      back to its generic globe. Kept in sync with the `rel="icon"` block in
      src/layouts/BrandLayout.astro and the pickleball standalone pages, all of
      which point at the same file.
    -->
    <link rel="icon" type="image/png" href="/devlabstudios-logo-only.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Admin — DevLab Studios CMS</title>
  </head>
  <body class="admin-page">
    <div id="admin-root">
      <AdminApp client:only="react" />
    </div>
  </body>
</html>
