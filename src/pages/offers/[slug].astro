---
import { CTA } from '../../config/ctas.js'
import BrandLayout from '../../layouts/BrandLayout.astro'
import PageHeader from '../../components/brand/PageHeader.astro'
import Symbol from '../../components/brand/Symbol.astro'
import LeadMagnetForm from '../../components/islands/LeadMagnetForm.jsx'
import { getBreadcrumbSchema } from '../../config/schema.js'
import { getLeadMagnet } from '../../config/offers.js'
import { resolveTurnstileSiteKey } from '../../lib/turnstileSiteKey'
import type { SeoData } from '../../lib/content/seo'

/**
 * Lead-magnet landing pages (BRAND-04, WEB-05: on the brand shell; the form,
 * its consent text and Turnstile are unchanged).
 *
 * Deliberately under /offers rather than /resources: `/resources/[slug]` is an
 * existing permanent redirect into /insights, and adding a second meaning to
 * that path would make one of the two silently shadow the other.
 *
 * The resource itself stays publicly readable at its /insights URL — this page
 * offers the emailed copy, it does not gate the content.
 */
const { slug } = Astro.params as { slug: string }
const offer = getLeadMagnet(slug)

if (!offer) {
  Astro.response.status = 404
}

const turnstileSiteKey = resolveTurnstileSiteKey(Astro.request.url)

const seo: SeoData | null = offer
  ? {
      metaTitle: `${offer.title} — DevLab Studios`,
      metaDescription: offer.summary,
      canonicalUrl: `https://www.devlabstudios.com/offers/${offer.id}`,
      ogTitle: offer.title,
      ogDescription: offer.summary,
      ogImage: 'https://www.devlabstudios.com/og.png',
    }
  : null

const covers = [
  'What has to be captured at intake, and what can wait',
  'Where qualification belongs, and what it should never decide alone',
  'How routing and ownership are assigned so no step is unclaimed',
  'What "delivered" has to mean before a submission is considered handled',
  'How a failed delivery becomes visible instead of silent',
  'Where the handoff to a person belongs',
]

const jsonLd = offer
  ? [
      getBreadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Insights', path: '/insights' },
        { name: offer.title, path: `/offers/${offer.id}` },
      ]),
    ]
  : []
---

<BrandLayout title={offer ? `${offer.title} · DevLab Studios` : 'Resource not found · DevLab Studios'} seo={seo} jsonLd={jsonLd} robots={offer ? undefined : 'noindex, follow'}>
  {!offer ? (
    <PageHeader eyebrow="Resource" heading="Resource not found" lead="This resource is not available. The Insights library has everything published.">
      <a href="/insights" class="dl-button-primary" data-cta-id="offer-missing-insights">Browse Insights</a>
    </PageHeader>
  ) : (
    <>
      <PageHeader breadcrumb={[{ label: 'Insights', href: '/insights' }]} eyebrow="Free resource" heading={offer.title} lead={offer.summary} />

      <div class="mx-auto grid max-w-container gap-10 px-[var(--gutter)] py-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start">
        <section aria-labelledby="offer-covers-heading">
          <h2 id="offer-covers-heading" class="text-step-2">What it covers</h2>
          <ul class="mt-6 divide-y divide-dl-rule border-y border-dl-rule">
            {covers.map((item) => (
              <li class="flex gap-3 py-3 text-dl-ink-2"><Symbol name="check" size={20} class="mt-0.5" /><span>{item}</span></li>
            ))}
          </ul>
          <p class="mt-6 text-dl-ink-2">
            Nothing here is gated. The full write-up is <a href={offer.path} data-cta-id="offer-read-online">published on the site</a>; the form only sends you a copy and an offer to talk it through.
          </p>
        </section>

        <section class="dl-form" aria-labelledby="offer-form-heading" data-view-event="lead_magnet_view" data-offer-id={offer.id}>
          <h2 id="offer-form-heading" class="text-step-2">Send me the checklist</h2>
          <p class="mt-2 text-dl-ink-2">One email with the checklist. No sequence, no list.</p>
          <div class="mt-6">
            <LeadMagnetForm client:load siteKey={turnstileSiteKey} offerId={offer.id} offerTitle={offer.title} ctaLabel={offer.ctaLabel} />
          </div>
        </section>
      </div>

      <section aria-labelledby="offer-next-heading" class="dl-band">
        <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)]">
          <h2 id="offer-next-heading" class="max-w-3xl text-step-3">Want this applied to your own intake and follow-up?</h2>
          <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2">The same checklist, run against your actual workflow, with a recommendation you can act on.</p>
          <a
            href={`/contact?type=business_system&insight=${offer.id}`}
            class="dl-button-primary mt-8"
            data-cta-id="offer-to-inquiry"
            data-cta-variant="primary"
            data-offer-id={offer.id}
            data-inquiry-type="business_system"
          >{CTA.line.intake}</a>
        </div>
      </section>
    </>
  )}
</BrandLayout>
