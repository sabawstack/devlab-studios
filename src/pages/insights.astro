---
/**
 * Insights hub (audit UX-09 / SEO-08 / BR.9): articles organised by the
 * problem they address, with mono problem tags and a filter that works
 * without JavaScript (?problem=<tag>). The audit is the offer beside the list;
 * the generated daily notes are linked, not promoted.
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import { getBreadcrumbSchema } from '../config/schema.js'
import { PROBLEM_TAGS } from '../config/problemTags.js'
import { getLeadMagnet } from '../config/offers.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadArticlesContent, formatArticleDate, type ArticlePost } from '../lib/content/articles'
import { INSIGHTS_INDEX, OFFER_AUDIT } from '../data/site/content.js'

type Post = ArticlePost & { problemTag?: string; audience?: string }

const seo = await loadPageSeo('insights')
const { posts } = await loadArticlesContent()
const published = (posts as Post[])
  .filter((post) => post.status !== 'draft' && post.status !== 'archived')
  .sort((left, right) => new Date(right.publishedAt || 0).getTime() - new Date(left.publishedAt || 0).getTime() || (left.sortOrder || 0) - (right.sortOrder || 0))

const tags = PROBLEM_TAGS.filter((tag) => published.some((post) => post.problemTag === tag.id))
const requested = Astro.url.searchParams.get('problem') || ''
const activeTag = tags.find((tag) => tag.id === requested) || null
const shown = activeTag ? published.filter((post) => post.problemTag === activeTag.id) : published
const tagLabel = (id?: string) => PROBLEM_TAGS.find((tag) => tag.id === id)?.label || ''
const leadMagnet = getLeadMagnet('lead-intake-checklist')
const jsonLd = [getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Insights', path: '/insights' }])]
---

<BrandLayout title="Insights · DevLab Studios" seo={seo} jsonLd={jsonLd}>
  <PageHeader eyebrow={INSIGHTS_INDEX.eyebrow} heading={INSIGHTS_INDEX.heading} lead={INSIGHTS_INDEX.lead} />

  <div class="mx-auto grid max-w-container gap-12 px-[var(--gutter)] py-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <section aria-labelledby="insights-list-heading">
      <h2 id="insights-list-heading" class="sr-only">{activeTag ? `Articles about ${activeTag.label.toLowerCase()}` : 'All articles'}</h2>
      <nav aria-label="Filter by problem">
        <ul class="flex flex-wrap gap-2">
          <li><a href="/insights" class={`dl-tag-link ${activeTag ? '' : 'is-active'}`} aria-current={activeTag ? undefined : 'page'}>All</a></li>
          {tags.map((tag) => (
            <li><a href={`/insights?problem=${tag.id}`} class={`dl-tag-link ${activeTag?.id === tag.id ? 'is-active' : ''}`} aria-current={activeTag?.id === tag.id ? 'page' : undefined}>{tag.label}</a></li>
          ))}
        </ul>
      </nav>

      <ul class="mt-8 divide-y divide-dl-rule border-y border-dl-rule">
        {shown.map((post) => (
          <li class="py-6" data-insight-card={post.slug}>
            <p class="label text-dl-ink-3">
              {post.problemTag ? tagLabel(post.problemTag) : post.category}
              {post.publishedAt && <span> · <time datetime={post.publishedAt}>{formatArticleDate(post.publishedAt)}</time></span>}
              {post.readingTimeMinutes ? <span> · {post.readingTimeMinutes} min</span> : null}
            </p>
            <h3 class="mt-2 text-step-2"><a href={`/insights/${post.slug}`} class="no-underline" data-cta-id="insights-article">{post.title}</a></h3>
            <p class="mt-2 text-dl-ink-2">{post.summary}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-step--1 text-dl-ink-3">
        Looking for the generated AI news notes? <a href="/insights/daily">Daily notes</a> are kept separately.
      </p>
    </section>

    <aside class="grid content-start gap-6">
      <div class="dl-band rounded-dl-s p-6">
        <p class="label text-dl-ink-3">Start here</p>
        <p class="mt-2 text-step-1 font-semibold">{OFFER_AUDIT.title}</p>
        <p class="mt-2 text-step--1 text-dl-ink-2">{OFFER_AUDIT.summary}</p>
        <a href={OFFER_AUDIT.contactHref} class="dl-button-primary mt-5" data-cta-id="insights-audit" data-inquiry-type="workflow_audit">Request the audit</a>
      </div>
      {leadMagnet && (
        <div class="rounded-dl-s border border-dl-rule p-6">
          <p class="label text-dl-ink-3">Free checklist</p>
          <p class="mt-2 font-semibold">{leadMagnet.title}</p>
          <a href={`/offers/${leadMagnet.id}`} class="dl-button-quiet mt-3" data-cta-id="insights-lead-magnet" data-offer-id={leadMagnet.id}>Get the checklist</a>
        </div>
      )}
    </aside>
  </div>
</BrandLayout>

<style>
  .dl-tag-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xs);
    font-family: var(--font-label);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
  }
  .dl-tag-link:hover { border-color: var(--ink-3); color: var(--ink); }
  .dl-tag-link.is-active { border-color: var(--ink); background: var(--ink); color: var(--paper); }
</style>
