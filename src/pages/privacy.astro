---
import LegalPage from '../components/brand/LegalPage.astro'
import { draftPreviewFor } from '../lib/content/preview'
import { loadPage } from '../lib/content/pages'
import { loadPageSeo } from '../lib/content/seo'

const seo = await loadPageSeo('privacy')
const page = await loadPage('privacy', { includeDrafts: await draftPreviewFor(Astro, { type: 'page', id: 'privacy' }) })
---

<LegalPage page={page} fallbackTitle="Privacy Policy" seo={seo}>
  {/* Lives in the page, not the CMS body, so it ships with the feature it describes. */}
  <section id="pickleball-open-play" class="border-t border-dl-rule py-8">
    <h2 class="text-step-2">Devlab Pickleball open play</h2>
    <p class="mt-3 text-dl-ink-2">
      Open play sessions need no account. The host's name and the players' names are shown on a public board that anyone with the
      session link can see. A session is deleted from the live service 7 days after the last change to it, though backups may keep
      its data for up to 30 days. The host can delete a session at any time.
    </p>
  </section>
</LegalPage>
