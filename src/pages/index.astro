---
/**
 * Home (spec N.10, H.2; UX-01; copy approved by the owner 2026-11-13): the
 * graphite hero band with S1, four ways work gets lost, the inquiry exhibit
 * beside a real screenshot, the three service lines, the audit offer with the
 * price line, and the closing call to action with the reply
 * window. Copy lives in src/data/site/content.js (HOME); the reply window,
 * hours and price line come from site settings (CMS-02). No section calls /api.
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import Section from '../components/brand/Section.astro'
import SceneFrame from '../components/brand/SceneFrame.astro'
import InquiryFlowExhibit from '../components/brand/InquiryFlowExhibit.astro'
import ProofMount from '../components/brand/ProofMount.astro'
import OfferCard from '../components/brand/OfferCard.astro'
import Symbol from '../components/brand/Symbol.astro'
import { getOrganizationSchema, getWebsiteSchema } from '../config/schema.js'
import { businessHoursLine, replyWindowLine } from '../config/business.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadSiteSettings } from '../lib/content/siteSettings'
import { loadWorkEntries } from '../lib/content/work'
import { HOME, SERVICE_LINES } from '../data/site/content.js'

const seo = await loadPageSeo('home')
const { business } = await loadSiteSettings()
const proof = (await loadWorkEntries()).find((entry) => entry.project.optimizedImageFull)
const jsonLd = [getOrganizationSchema(), getWebsiteSchema()]
const LINE_SYMBOLS = { 'lead-intake-and-follow-up': 'inbox', 'workflow-and-ai-automation': 'process', 'custom-software-and-operations': 'api' } as const
---

<BrandLayout title="Business systems that don't quietly lose work · DevLab" seo={seo} jsonLd={jsonLd}>
  <PageHeader heading={HOME.hero.heading} lead={HOME.hero.lead} ink>
    <a href={HOME.hero.primary.href} class="dl-button-primary" data-cta-id="home-hero-primary" data-cta-variant="primary" data-inquiry-type="business_system">{HOME.hero.primary.label}</a>
    <a href={HOME.hero.secondary.href} class="dl-button-quiet" data-cta-id="home-hero-secondary" data-cta-variant="secondary">{HOME.hero.secondary.label}</a>
    <div slot="aside">
      <SceneFrame sceneId="fragmented-intake" caption={HOME.hero.sceneCaption} />
    </div>
  </PageHeader>

  <Section id="home-problems" eyebrow={HOME.problems.eyebrow} heading={HOME.problems.heading}>
    <ul class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4" data-problems>
      {HOME.problems.items.map((item) => (
        <li class="border-t border-dl-rule pt-5" data-problem-id={item.id}>
          <Symbol name={item.symbol} />
          <h3 class="mt-4 text-step-1">{item.problem}</h3>
          <p class="mt-2 text-dl-ink-2">{item.fix}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="home-exhibit" eyebrow={HOME.exhibit.eyebrow} heading={HOME.exhibit.heading} class="border-t border-dl-rule">
    <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2">{HOME.exhibit.caption}</p>
    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start">
      <InquiryFlowExhibit />
      {proof?.project.optimizedImageFull && (
        <div>
          <p class="label text-dl-ink-3">{HOME.exhibit.proofLabel}</p>
          <ProofMount
            class="mt-3"
            picture={proof.project.optimizedImageFull}
            caption={`${proof.project.title}: the workflow as built.`}
            looking="A real screenshot, with client data removed."
          />
          <a href={`/work/${proof.slug}`} class="dl-button-quiet mt-4" data-cta-id="home-proof-writeup">Read the write-up<span class="sr-only">: {proof.project.title}</span></a>
        </div>
      )}
    </div>
  </Section>

  <Section id="home-solutions" eyebrow={HOME.solutions.eyebrow} heading={HOME.solutions.heading} class="border-t border-dl-rule">
    <ul class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-3">
      {SERVICE_LINES.map((line) => (
        <li class="flex flex-col border-t border-dl-rule pt-5" data-solution-id={line.solutionId}>
          <Symbol name={LINE_SYMBOLS[line.slug as keyof typeof LINE_SYMBOLS] ?? 'process'} />
          <h3 class="mt-4 text-step-1">{line.title}</h3>
          <p class="mt-2 text-dl-ink-2">{line.problem}</p>
          <a href={`/solutions/${line.slug}`} class="dl-button-quiet mt-4 self-start" data-cta-id={`home-solution-${line.slug}`}>
            {HOME.solutions.linkLabel}<span class="sr-only">: {line.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="home-start" eyebrow="Start here" heading="Start with one workflow." class="border-t border-dl-rule">
    <div class="mt-10">
      <OfferCard
        title={HOME.audit.title}
        text={HOME.audit.text}
        deliverables={HOME.audit.deliverables}
        priceLine={business.auditPriceLine}
        primary={HOME.audit.primary}
        secondary={HOME.audit.secondary}
      />
    </div>
  </Section>

  <section id="home-cta" aria-labelledby="home-cta-heading" class="dl-band">
    <div class="mx-auto max-w-container px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.75)]">
      <h2 id="home-cta-heading" class="max-w-3xl text-step-3">{HOME.final.heading}</h2>
      <p class="mt-4 max-w-prose text-step-1 text-dl-ink-2" data-reply-window>
        You get a receipt right away; a person replies {replyWindowLine(business)}. Hours: {businessHoursLine(business)}.
      </p>
      <a href={HOME.final.primary.href} class="dl-button-primary mt-8" data-cta-id="home-final-primary" data-cta-variant="primary" data-inquiry-type="business_system">{HOME.final.primary.label}</a>
    </div>
  </section>
</BrandLayout>
