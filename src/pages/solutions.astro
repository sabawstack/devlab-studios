---
/**
 * Solutions index (audit UX-07 / G.1 / BR.9): three service lines and one way
 * to start. Each line links to its own page under /solutions/<slug>; the old
 * in-page anchors (#lead-intake-followup, …) still land on the matching item.
 */
import BrandLayout from '../layouts/BrandLayout.astro'
import PageHeader from '../components/brand/PageHeader.astro'
import Section from '../components/brand/Section.astro'
import SceneFrame from '../components/brand/SceneFrame.astro'
import { createFigureCounter } from '../components/brand/figures'
import { getBreadcrumbSchema, getServiceSchema } from '../config/schema.js'
import { loadPageSeo } from '../lib/content/seo'
import { DELIVERY_STEPS, OFFER_AUDIT, SERVICE_LINES, SOLUTIONS_INDEX, serviceLineContactHref } from '../data/site/content.js'

const seo = await loadPageSeo('solutions')
const figures = createFigureCounter()
const jsonLd = [
  getBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Solutions', path: '/solutions' }]),
  ...SERVICE_LINES.map((line) => getServiceSchema({ id: line.slug, title: line.title, description: line.outcome, capabilities: line.includes, path: `/solutions/${line.slug}` })),
]
---

<BrandLayout title="Solutions · DevLab Studios" seo={seo} jsonLd={jsonLd}>
  <PageHeader eyebrow={SOLUTIONS_INDEX.eyebrow} heading={SOLUTIONS_INDEX.heading} lead={SOLUTIONS_INDEX.lead}>
    <a href={OFFER_AUDIT.path} class="dl-button-primary" data-cta-id="solutions-hero-audit">Start with the audit</a>
    <a href="/contact?type=business_system" class="dl-button-quiet" data-cta-id="solutions-hero-contact">Discuss your system</a>
  </PageHeader>

  {SERVICE_LINES.map((line, index) => (
    <section id={line.solutionId} aria-labelledby={`${line.slug}-heading`} class="scroll-mt-24 border-b border-dl-rule" data-solution-id={line.solutionId}>
      <div class="mx-auto grid max-w-container gap-10 px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center">
        <div>
          <p class="label text-dl-ink-3">{String(index + 1).padStart(2, '0')} · Service line</p>
          <h2 id={`${line.slug}-heading`} class="mt-2 text-step-3">{line.title}</h2>
          <p class="mt-4 text-step-1 text-dl-ink-2">{line.problem}</p>
          <p class="mt-3 text-dl-ink">{line.outcome}</p>
          <ul class="mt-6 grid gap-2 text-dl-ink-2">
            {line.includes.slice(0, 3).map((item) => <li class="flex gap-3"><span aria-hidden="true" class="label pt-1 text-dl-ink-3">—</span>{item}</li>)}
          </ul>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
            <a href={serviceLineContactHref(line)} class="dl-button-primary" data-cta-id={`solutions-${line.slug}-contact`} data-inquiry-type={line.inquiryType}>{line.ctaLabel}</a>
            <a href={`/solutions/${line.slug}`} class="dl-button-quiet" data-cta-id={`solutions-${line.slug}-details`}>What this includes<span class="sr-only">: {line.title}</span></a>
          </div>
        </div>
        <SceneFrame sceneId={line.sceneId} figure={figures.next()} />
      </div>
    </section>
  ))}

  <section id={OFFER_AUDIT.slug} aria-labelledby="audit-heading" class="ink-panel scroll-mt-24">
    <div class="mx-auto grid max-w-container gap-10 px-[var(--gutter)] py-[calc(var(--section-rhythm)*0.6)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center">
      <div>
        <p class="label text-dl-ink-3">Start here</p>
        <h2 id="audit-heading" class="mt-2 text-step-3">{OFFER_AUDIT.title}</h2>
        <p class="mt-4 text-step-1 text-dl-ink-2">{OFFER_AUDIT.summary}</p>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
          <a href={OFFER_AUDIT.contactHref} class="dl-button-primary" data-cta-id="solutions-audit-contact" data-inquiry-type="workflow_audit">Request the audit</a>
          <a href={OFFER_AUDIT.path} class="dl-button-quiet" data-cta-id="solutions-audit-details">What you receive</a>
        </div>
      </div>
      <SceneFrame sceneId="workflow-audit" figure={figures.next()} />
    </div>
  </section>

  <Section id="solutions-delivery" eyebrow="Delivery" heading={SOLUTIONS_INDEX.deliveryHeading}>
    <ol class="mt-10 grid gap-px overflow-hidden rounded-dl-s border border-dl-rule bg-dl-rule sm:grid-cols-2 lg:grid-cols-4">
      {DELIVERY_STEPS.map((step, index) => (
        <li class="bg-dl-paper p-6">
          <p class="label text-dl-ink-3">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-step-1">{step.title}</h3>
          <p class="mt-2 text-dl-ink-2">{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>
</BrandLayout>
